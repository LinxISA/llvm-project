//
// This file defines the LinxV5-specific builtin function database.  Users of
// this file must define the BUILTIN macro to make use of this information.
//
//===----------------------------------------------------------------------===//

#if defined(BUILTIN) && !defined(TARGET_BUILTIN)
#   define TARGET_BUILTIN(ID, TYPE, ATTRS, FEATURE) BUILTIN(ID, TYPE, ATTRS)
#endif

BUILTIN(__builtin_linx_get_system_reg, "ULiULi", "n")

// Returns the current PE's thread index (0..kThreadsPerBlock-1).
// Aligned with website manual get_thread_idx(). Lowered to SSR_GET reading
// a PE-id SSR (SSR-ID 16 placeholder, pending ISA assignment).
BUILTIN(__builtin_linx_get_thread_idx, "Ui", "nc")

BUILTIN(blkv_max,  "v.", "nt")
BUILTIN(blkv_min, "v.", "nt")
BUILTIN(blkv_fabs, "v.", "nt")
BUILTIN(blkv_fsqrt, "v.", "nt")
BUILTIN(blkv_fexp, "v.", "nt")
BUILTIN(blkv_shuffle_bfly, "v.", "nt")
BUILTIN(blkv_rdmax,  "v.", "nt")
BUILTIN(blkv_rdmin, "v.", "nt")
BUILTIN(blkv_rdadd,  "v.", "nt")
BUILTIN(blkv_rdor,   "v.", "nt")

BUILTIN(blk_matmul, "v.", "nt")
BUILTIN(blk_matmul_ac, "v.", "nt")
BUILTIN(blk_matmulmx, "v.", "nt")
BUILTIN(blk_matmulmx_ac, "v.", "nt")
BUILTIN(blk_matmulmxb, "v.", "nt")
BUILTIN(blk_matmulmxb_ac, "v.", "nt")
BUILTIN(blk_tload, "v.", "nt")
BUILTIN(blk_tstore, "v.", "nt")
BUILTIN(blk_acccvt, "v.", "nt")
