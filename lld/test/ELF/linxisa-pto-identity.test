# RUN: split-file %s %t
# RUN: yaml2obj -DREL=35 -DFLAG=SHF_ALLOC %t/identity.yaml -o %t/canonical.o
# RUN: ld.lld -m elf64linx -e 0 %t/canonical.o %t/canonical.o -o %t/out
# RUN: llvm-readelf -S -x .note.pto.isa %t/out | FileCheck %s --check-prefix=OUTPUT
# RUN: ld.lld -m elf64linx -shared %t/canonical.o -o %t/canonical.so
# RUN: ld.lld -m elf64linx -e 0 %t/canonical.o %t/canonical.so -o %t/with-so
# RUN: llvm-readelf -S %t/canonical.so %t/with-so | FileCheck %s --check-prefix=RELINK
# RUN: ld.lld -m elf64linx -r %t/canonical.o %t/canonical.o -o %t/reloc.o
# RUN: ld.lld -m elf64linx -e 0 %t/reloc.o -o %t/reloc-out
# RUN: llvm-readelf -S %t/reloc.o %t/reloc-out | FileCheck %s --check-prefix=RELINK
# RUN: yaml2obj %t/missing.yaml -o %t/missing.o
# RUN: not ld.lld -m elf64linx -e 0 %t/canonical.o %t/missing.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING
# RUN: yaml2obj -DABI=71 -DREL=35 -DFLAG=SHF_ALLOC %t/identity.yaml -o %t/abi.o
# RUN: not ld.lld -m elf64linx -e 0 %t/canonical.o %t/abi.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=ABI
# RUN: yaml2obj -DHASH=39 -DREL=35 -DFLAG=SHF_ALLOC %t/identity.yaml -o %t/hash.o
# RUN: not ld.lld -m elf64linx -e 0 %t/canonical.o %t/hash.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=HASH
# RUN: yaml2obj -DREL=30 -DFLAG=SHF_ALLOC %t/identity.yaml -o %t/release.o
# RUN: not ld.lld -m elf64linx -e 0 %t/canonical.o %t/release.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=RELEASE
# RUN: yaml2obj -DREL=35 -DFLAG=SHF_WRITE %t/identity.yaml -o %t/flags.o
# RUN: not ld.lld -m elf64linx -e 0 %t/canonical.o %t/flags.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=FLAGS

# OUTPUT-COUNT-1: .note.pto.isa     NOTE
# OUTPUT-SAME: 0000b8
# OUTPUT-SAME: A
# OUTPUT-SAME: 4
# OUTPUT: 04000000 a5000000 01000000 50544f00
# OUTPUT: 7b22656e 636f6469 6e675f61 6269223a
# OUTPUT: 382e3522 7d000000
# RELINK-COUNT-2: .note.pto.isa     NOTE
# MISSING: error: {{.*}}missing.o: missing required .note.pto.isa identity
# ABI: error: {{.*}}abi.o: invalid .note.pto.isa: encoding ABI mismatch
# HASH: error: {{.*}}hash.o: invalid .note.pto.isa: encoding projection hash mismatch
# RELEASE: error: {{.*}}release.o: invalid .note.pto.isa: release mismatch (expected 0.58.5)
# FLAGS: error: {{.*}}flags.o: invalid .note.pto.isa: section flags must be exactly SHF_ALLOC

#--- identity.yaml
!ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: 0xE9
Sections:
  - Name:         .note.pto.isa
    Type:         SHT_NOTE
    Flags:        [ [[FLAG]] ]
    AddressAlign: 4
    Content:      04000000a50000000100000050544f007b22656e636f64696e675f616269223a22[[ABI=70]]746f2d6973612d302e35382e352d6d6f64652d66756e6374696f6e2d7631222c22656e636f64696e675f70726f6a656374696f6e5f736861323536223a2263[[HASH=34]]6130313838663463393038373338386665363233396534656332646136353530623831633837626231343636653631353764363961396161343566373437222c2272656c65617365223a22302e35382e[[REL]]227d000000

#--- missing.yaml
!ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: 0xE9
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  2
