--- |
  ; ModuleID = 'tmp/simt_break_test.ll'
  source_filename = "tmp/simt_break_test.cpp"
  target datalayout = "e-m:e-p:64:64-i8:8:64-i16:16:64-i32:32:64-i64:64-i128:128-n64-S128"
  target triple = "linx64v5-unknown-linux-musl"
  
  ; Function Attrs: argmemonly mustprogress nofree noinline nounwind
  define dso_local void @simt_break_test(ptr noundef %in, ptr nocapture noundef writeonly %out, i32 noundef signext %max_probe) local_unnamed_addr #0 {
  entry:
    %cmp13 = icmp sgt i32 %max_probe, 0
    br i1 %cmp13, label %for.body.lr.ph, label %cleanup3, !structurizecfg.uniform !6
  
  for.body.lr.ph:                                   ; preds = %entry
    %0 = tail call i16 @llvm.blkv.get.index.x()
    %1 = and i16 %0, 1
    %tobool = icmp ne i16 %1, 0
    %wide.trip.count = zext i32 %max_probe to i64
    br label %for.body, !structurizecfg.uniform !6
  
  for.body:                                         ; preds = %Flow, %for.body.lr.ph
    %phi.broken = phi i64 [ %10, %Flow ], [ 0, %for.body.lr.ph ]
    %indvars.iv = phi i64 [ 0, %for.body.lr.ph ], [ %9, %Flow ]
    %acc.015 = phi i32 [ 0, %for.body.lr.ph ], [ %merge4, %Flow ]
    %2 = tail call i16 @llvm.blkv.get.index.x()
    %3 = zext i16 %2 to i64
    %4 = add i64 %indvars.iv, %3
    %arrayidx = getelementptr inbounds i32, ptr %in, i64 %4
    %5 = load volatile i32, ptr %arrayidx, align 4, !tbaa !7
    %cmp1 = icmp eq i64 %indvars.iv, 3
    %or.cond = select i1 %tobool, i1 %cmp1, i1 false
    %or.cond.inv = xor i1 %or.cond, true
    %6 = call { i1, i64 } @llvm.blkv.if.i64(i1 %or.cond.inv)
    %7 = extractvalue { i1, i64 } %6, 0
    %8 = extractvalue { i1, i64 } %6, 1
    br i1 %7, label %for.inc, label %Flow
  
  for.inc:                                          ; preds = %for.body
    %add2 = add nsw i32 %5, %acc.015
    %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
    %exitcond.not = icmp eq i64 %wide.trip.count, %indvars.iv.next
    br label %Flow
  
  Flow:                                             ; preds = %for.inc, %for.body
    %.phi16 = phi i1 [ true, %for.inc ], [ true, %for.body ]
    %.phi05 = phi i1 [ %exitcond.not, %for.inc ], [ undef, %for.body ]
    %.phi13 = phi i32 [ undef, %for.inc ], [ undef, %for.body ]
    %.phi02 = phi i32 [ %add2, %for.inc ], [ undef, %for.body ]
    %.phi1 = phi i32 [ %5, %for.inc ], [ %5, %for.body ]
    %.phi0 = phi i32 [ %add2, %for.inc ], [ undef, %for.body ]
    %9 = phi i64 [ %indvars.iv.next, %for.inc ], [ undef, %for.body ]
    %merge = call i32 @llvm.blkv.merge.cf.i32(i32 %.phi0, i32 %.phi1)
    %merge4 = call i32 @llvm.blkv.merge.cf.i32(i32 %.phi02, i32 %.phi13)
    %merge7 = call i1 @llvm.blkv.merge.cf.i1(i1 %.phi05, i1 %.phi16)
    call void @llvm.blkv.end.cf.i64(i64 %8)
    %10 = call i64 @llvm.blkv.if.break.i64(i1 %merge7, i64 %phi.broken)
    %11 = call i1 @llvm.blkv.loop.i64(i64 %10)
    br i1 %11, label %Flow1, label %for.body
  
  Flow1:                                            ; preds = %Flow
    call void @llvm.blkv.end.cf.i64(i64 %10)
    br label %cleanup3
  
  cleanup3:                                         ; preds = %Flow1, %entry
    %acc.2 = phi i32 [ 0, %entry ], [ %merge, %Flow1 ]
    %12 = tail call i16 @llvm.blkv.get.index.x()
    %13 = zext i16 %12 to i64
    %arrayidx5 = getelementptr inbounds i32, ptr %out, i64 %13
    store i32 %acc.2, ptr %arrayidx5, align 4, !tbaa !7
    ret void
  }
  
  ; Function Attrs: nounwind readnone
  declare i16 @llvm.blkv.get.index.x() #1
  
  ; Function Attrs: convergent nounwind willreturn
  declare { i1, i64 } @llvm.blkv.if.i64(i1) #2
  
  ; Function Attrs: convergent nounwind willreturn
  declare { i1, i64 } @llvm.blkv.flow.i64.i64(i64) #2
  
  ; Function Attrs: convergent nounwind readnone willreturn
  declare i64 @llvm.blkv.if.break.i64(i1, i64) #3
  
  ; Function Attrs: convergent nounwind willreturn
  declare i1 @llvm.blkv.loop.i64(i64) #2
  
  ; Function Attrs: convergent nounwind willreturn
  declare void @llvm.blkv.end.cf.i64(i64) #2
  
  ; Function Attrs: convergent nounwind willreturn
  declare i32 @llvm.blkv.merge.cf.i32(i32, i32) #2
  
  ; Function Attrs: convergent nounwind willreturn
  declare i1 @llvm.blkv.merge.cf.i1(i1, i1) #2
  
  attributes #0 = { argmemonly mustprogress nofree noinline nounwind "__mtc__" "frame-pointer"="none" "min-legal-vector-width"="0" "no-builtins" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-features"="+relax" }
  attributes #1 = { nounwind readnone }
  attributes #2 = { convergent nounwind willreturn }
  attributes #3 = { convergent nounwind readnone willreturn }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 1, !"target-abi", !"lp64"}
  !2 = !{i32 7, !"PIC Level", i32 2}
  !3 = !{i32 7, !"PIE Level", i32 2}
  !4 = !{i32 1, !"SmallDataLimit", i32 8}
  !5 = !{!"clang version 15.0.4 (linx64v5-musl-local f25aa63f7aa291eff97acefb9fa16fe7a9d6580c)"}
  !6 = !{}
  !7 = !{!8, !8, i64 0}
  !8 = !{!"int", !9, i64 0}
  !9 = !{!"omnipotent char", !10, i64 0}
  !10 = !{!"Simple C++ TBAA"}

...
