--- |
  ; ModuleID = '<stdin>'
  source_filename = "<stdin>"
  target datalayout = "e-m:e-p:64:64-i8:8:64-i16:16:64-i32:32:64-i64:64-i128:128-n64-S128"
  target triple = "linx64v5-unknown-linux-musl"
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @csel64(ptr %p, ptr %addra, ptr %addrb) #0 {
  entry:
    %a = load i64, ptr %addra, align 8
    %b = load i64, ptr %addrb, align 8
    %cmp = icmp eq i64 %a, %b
    %ret = select i1 %cmp, i64 %a, i64 %b
    store i64 %ret, ptr %p, align 8
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @csel32(ptr %p, ptr %addra, ptr %addrb) #0 {
  entry:
    %a = load i32, ptr %addra, align 4
    %b = load i32, ptr %addrb, align 4
    %cmp = icmp eq i32 %a, %b
    %ret = select i1 %cmp, i32 %a, i32 %b
    store i32 %ret, ptr %p, align 4
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @csel16(ptr %p, ptr %addra, ptr %addrb) #0 {
  entry:
    %a = load i16, ptr %addra, align 2
    %b = load i16, ptr %addrb, align 2
    %cmp = icmp eq i16 %a, %b
    %ret = select i1 %cmp, i16 %a, i16 %b
    store i16 %ret, ptr %p, align 2
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @csel8(ptr %p, ptr %addra, ptr %addrb) #0 {
  entry:
    %a = load i8, ptr %addra, align 1
    %b = load i8, ptr %addrb, align 1
    %cmp = icmp eq i8 %a, %b
    %ret = select i1 %cmp, i8 %a, i8 %b
    store i8 %ret, ptr %p, align 1
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @cself64(ptr %p, ptr %addra, ptr %addrb) #0 {
    %a = load double, ptr %addra, align 8
    %b = load double, ptr %addrb, align 8
    %cmp = fcmp oeq double %a, %b
    %sel = select i1 %cmp, double %a, double %b
    store double %sel, ptr %p, align 8
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @cself32(ptr %p, ptr %addra, ptr %addrb) #0 {
    %a = load float, ptr %addra, align 4
    %b = load float, ptr %addrb, align 4
    %cmp = fcmp oeq float %a, %b
    %sel = select i1 %cmp, float %a, float %b
    store float %sel, ptr %p, align 4
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @cself16(ptr %p, ptr %addra, ptr %addrb) #0 {
    %a = load half, ptr %addra, align 2
    %b = load half, ptr %addrb, align 2
    %cmp = fcmp oeq half %a, %b
    %sel = select i1 %cmp, half %a, half %b
    store half %sel, ptr %p, align 2
    ret void
  }
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind readnone willreturn
  define void @cselbf16(ptr %p, ptr %addra, ptr %addrb) #0 {
    %a = load bfloat, ptr %addra, align 2
    %b = load bfloat, ptr %addrb, align 2
    %cmp = fcmp oeq bfloat %a, %b
    %sel = select i1 %cmp, bfloat %a, bfloat %b
    store bfloat %sel, ptr %p, align 2
    ret void
  }
  
  ; Function Attrs: convergent nounwind willreturn
  declare { i1, i64 } @llvm.blkv.if.i64(i1) #1
  
  ; Function Attrs: convergent nounwind willreturn
  declare { i1, i64 } @llvm.blkv.flow.i64.i64(i64) #1
  
  ; Function Attrs: convergent nounwind readnone willreturn
  declare i64 @llvm.blkv.if.break.i64(i1, i64) #2
  
  ; Function Attrs: convergent nounwind willreturn
  declare i1 @llvm.blkv.loop.i64(i64) #1
  
  ; Function Attrs: convergent nounwind willreturn
  declare void @llvm.blkv.end.cf.i64(i64) #1
  
  attributes #0 = { mustprogress nofree noinline norecurse nosync nounwind readnone willreturn "__vec__" "frame-pointer"="none" "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-features"="+m,+relax" }
  attributes #1 = { convergent nounwind willreturn }
  attributes #2 = { convergent nounwind readnone willreturn }

...
