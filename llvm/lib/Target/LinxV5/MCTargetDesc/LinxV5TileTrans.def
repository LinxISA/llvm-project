// LinxV5 block tile layout transport selector codes (PTO-ISA ADR-0069 /
// ADR-0070, pto-spec main 23ca883).
//
// B.DATR.Layout is a 5-bit field whose assigned values are the ordinary
// GM<->Local data-layout transport conversions plus the six CUBE cell
// transport selectors. The active ISA assigned set is
//   {0,1,3,4,6,8,9,17,18,20,21,22,23,24,25,26,27,28,30}
// (see asl/block/model/state/control-state.asl TileDataLayoutOfCode).
//
// Codes 21..23 select GM->Local CUBE transport (legal only for TLOAD) and
// codes 24..26 select Local->GM CUBE transport (legal only for TSTORE):
//   21 ND2M32: GM ordinary -> Local CUBE_M32
//   22 ND2M16: GM ordinary -> Local CUBE_M16
//   23 ND2N8 : GM ordinary -> Local CUBE_N8
//   24 M322ND: Local CUBE_M32 -> GM ordinary
//   25 M162ND: Local CUBE_M16 -> GM ordinary
//   26 N82ND : Local CUBE_N8  -> GM ordinary
// All six are illegal for Shared Tile bindings. Codes not in the assigned
// set (2,5,7,10..16,19,29,31) are reserved and must be rejected; they get
// unique RESERVE_<N> placeholders so the ArgFormat enum stays total (the
// parser never produces these names and the disassembler rejects them).
TRANS(NORM, 0)
TRANS(ND2DN, 1)
TRANS(RESERVE_2, 2)
TRANS(ND2ZN, 3)
TRANS(ND2NZ, 4)
TRANS(RESERVE_5, 5)
TRANS(DN2ND, 6)
TRANS(RESERVE_7, 7)
TRANS(DN2ZN, 8)
TRANS(DN2NZ, 9)
TRANS(RESERVE_10, 10)
TRANS(RESERVE_11, 11)
TRANS(RESERVE_12, 12)
TRANS(RESERVE_13, 13)
TRANS(RESERVE_14, 14)
TRANS(RESERVE_15, 15)
TRANS(RESERVE_16, 16)
TRANS(ZN2ND, 17)
TRANS(ZN2DN, 18)
TRANS(RESERVE_19, 19)
TRANS(ZN2NZ, 20)
TRANS(ND2M32, 21)
TRANS(ND2M16, 22)
TRANS(ND2N8, 23)
TRANS(M322ND, 24)
TRANS(M162ND, 25)
TRANS(N82ND, 26)
TRANS(NZ2ND, 27)
TRANS(NZ2DN, 28)
TRANS(RESERVE_29, 29)
TRANS(NZ2ZN, 30)
TRANS(RESERVE_31, 31)