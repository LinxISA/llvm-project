define void @sum_liveout(ptr nocapture noundef readonly %a, ptr nocapture noundef writeonly %out) local_unnamed_addr {
entry:
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi float [ 0.000000e+00, %entry ], [ %acc.next, %loop ]
  %ptr = getelementptr inbounds float, ptr %a, i64 %i
  %val = load float, ptr %ptr, align 4
  %acc.next = fadd float %acc, %val
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, 64
  br i1 %done, label %exit, label %loop

exit:                                             ; preds = %loop
  store float %acc.next, ptr %out, align 4
  ret void
}

