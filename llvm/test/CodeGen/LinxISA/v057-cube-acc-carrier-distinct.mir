# RUN: llc -mtriple=linx64 -run-pass=linx-blockify -o - %s | FileCheck %s

# The MAMULB.ACC carrier and destination deliberately use distinct physical
# registers. Consuming $tile16 before publishing $tile17 keeps the older
# $tile19 at architectural M#2; retaining a stale carrier would make it M#3.
# $tile18 is also an M-hand matrix source, so its header rank must be frozen
# before the M-hand accumulator carrier is released at commit.
# CHECK-LABEL: name: acc_carrier_distinct
# CHECK: B_IOT_SIZE_G1 4, 0, 0, 0, 0, 33, 1, 8
# CHECK: B_IOT_SIZE_G1 7, 0, 0, 0, 1, 33, 0, 8
# CHECK: B_IOT_SIZE_G1 7, 0, 0, 0, 1, 32, 0, 8
# CHECK-LABEL: name: acccvt_carrier_distinct
# CHECK: B_IOT_SIZE_G1 7, 0, 0, 0, 1, 33, 0, 8
# CHECK: B_IOT_SIZE_G1 7, 0, 0, 0, 1, 32, 0, 8

--- |
  define void @acc_carrier_distinct(ptr %a, ptr %b, ptr %out) {
  entry:
    ret void
  }
  define void @acccvt_carrier_distinct(ptr %a, ptr %b, ptr %out) {
  entry:
    ret void
  }
...
---
name:            acccvt_carrier_distinct
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
body:             |
  bb.0:
    liveins: $r2, $r3, $r4

    $tile0 = PSEUDO_TMA_TLOAD $r2, 8
    $tile1 = PSEUDO_TMA_TLOAD $r3, 8
    $tile19 = PSEUDO_CUBE_MAMULB $tile0, $tile1, 4, 4, 4
    $tile16 = PSEUDO_CUBE_MAMULB killed $tile0, killed $tile1, 4, 4, 4
    $tile17 = PSEUDO_CUBE_ACCCVT killed $tile16, 8, 0, 0, 0
    PSEUDO_TMA_TSTORE $r4, killed $tile19, 8
    PSEUDO_TMA_TSTORE killed $r4, killed $tile17, 8
    PSEUDO_RET implicit $r10
...
---
name:            acc_carrier_distinct
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
body:             |
  bb.0:
    liveins: $r2, $r3, $r4

    $tile0 = PSEUDO_TMA_TLOAD $r2, 8
    $tile1 = PSEUDO_TMA_TLOAD $r3, 8
    $tile19 = PSEUDO_CUBE_MAMULB $tile0, $tile1, 4, 4, 4
    $tile18 = PSEUDO_CUBE_MAMULB $tile0, $tile1, 4, 4, 4
    $tile16 = PSEUDO_CUBE_MAMULB $tile0, $tile1, 4, 4, 4
    $tile17 = PSEUDO_CUBE_MAMULB_ACC killed $tile16, killed $tile18, killed $tile0, 4, 4, 4
    PSEUDO_TMA_TSTORE $r4, killed $tile19, 8
    PSEUDO_TMA_TSTORE killed $r4, killed $tile17, 8
    PSEUDO_RET implicit $r10
...
