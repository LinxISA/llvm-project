# RUN: llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance -o - %s | FileCheck %s --check-prefix=BAL
# RUN: llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance,linx-blockify -o - %s | FileCheck %s --check-prefix=BLK

# BAL-LABEL: name: tile_phi_edge
# BAL: bb.1:
# BAL: $tile2 = PSEUDO_TMA_TMOV killed $tile0, 8, 17, 0, 0, 0, 0
# BAL: bb.2:
# BAL: $tile2 = PSEUDO_TMA_TMOV $tile1, 8, 17, 0, 0, 0, 1
# BAL-NOT: = COPY

# BLK-LABEL: name: tile_phi_edge
# BLK: bb.1:
# BLK: BSTART_TMA 17, 2
# BLK-NEXT: B_DATR 0, 0, 0, 0, 17, 0
# BLK: B_IOT_SIZE_G1
# BLK: bb.2:
# BLK: BSTART_TMA 17, 2
# BLK-NEXT: B_DATR 0, 0, 0, 0, 17, 0
# BLK: B_IOT_SIZE_G1
# BLK-NOT: PSEUDO_TMA_TMOV

--- |
  define i64 @tile_phi_edge(i64 %cond, ptr %a, ptr %b, ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_phi_edge
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3, $r4, $r5

    $tile0 = PSEUDO_TMA_TLOAD killed $r3, 8
    $tile1 = PSEUDO_TMA_TLOAD killed $r4, 8
    BNE killed $r2, $r0, %bb.1
    JUMP %bb.2

  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $tile0, $r5

    $tile2 = COPY killed $tile0
    JUMP %bb.3

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $tile1, $r5

    $tile2 = COPY $tile1
    JUMP %bb.3

  bb.3:
    liveins: $tile2, $r5, $r3

    PSEUDO_TMA_TSTORE killed $r5, killed $tile2, 8
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
