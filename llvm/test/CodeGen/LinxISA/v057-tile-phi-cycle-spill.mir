# RUN: llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance -o - %s | FileCheck %s

# CHECK-LABEL: name: tile_phi_cycle_spill
# CHECK: bb.1:
# CHECK: PSEUDO_TMA_TSTORE
# CHECK: $tile31 = PSEUDO_TMA_TMOV
# CHECK: $tile0 = PSEUDO_TMA_TLOAD_ANY
# CHECK-NOT: = COPY

--- |
  define i64 @tile_phi_cycle_spill(ptr %a, ptr %b, ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_phi_cycle_spill
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r3, $r4, $r5

    $tile0 = PSEUDO_TMA_TLOAD killed $r3, 8
    $tile31 = PSEUDO_TMA_TLOAD_ANY killed $r4, 8
    JUMP %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $tile0, $tile31

    $tile0 = COPY killed $tile31
    $tile31 = COPY killed $tile0
    JUMP %bb.2

  bb.2:
    liveins: $tile0, $r5, $r3

    PSEUDO_TMA_TSTORE killed $r5, killed $tile0, 8
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
