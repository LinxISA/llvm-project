    $tile1 = PSEUDO_TLSU_TMOV killed $tile0, 6, 31, 0, 0, 0
    $tile2 = PSEUDO_TLSU_TMOV killed $tile1, 6, 31, 17, 1, 0
    PSEUDO_RET implicit $r10
...
