body:             |
  bb.0:
    liveins: $r3
    $tile0 = PSEUDO_TLSU_TLOAD $r3, 6
    $tile1 = PSEUDO_TLSU_TMOV killed $tile0, 6, 31, 2, 1, 0
    PSEUDO_RET implicit $r10
...

