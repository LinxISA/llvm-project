# RUN: llc -mtriple=linx64 -run-pass=linx-blockify -o - %s | FileCheck %s

# CHECK-LABEL: name: tile_tmov_a2v
# CHECK: BSTART_TMA 0, 2
# CHECK-NEXT: B_ARG 1
# CHECK: B_IOT_SIZE_G1 0, 0, 1, 0, 1, 0, 0, 8, implicit-def $tile0

--- |
  define i64 @tile_tmov_a2v(ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_tmov_a2v
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$tile1', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    liveins: $tile1, $r4, $r3

    $tile0 = PSEUDO_TMA_TMOV $tile1, 8, 0, 0, 0, 1, 0
    PSEUDO_TMA_TSTORE killed $r4, killed $tile0, 8
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
