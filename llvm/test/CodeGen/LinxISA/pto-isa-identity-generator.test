# RUN: split-file %s %t
# RUN: %python %S/../../../utils/pto/generate_pto_isa_identity.py --manifest %t/manifest.json --output %t/PTOISA.h
# RUN: FileCheck %s --check-prefix=HEADER < %t/PTOISA.h
# RUN: %python %S/../../../utils/pto/generate_pto_isa_identity.py --manifest %t/manifest.json --output %t/PTOISA.h --check
# RUN: not %python %S/../../../utils/pto/generate_pto_isa_identity.py --manifest %t/stale.json --output %t/PTOISA.h --check 2>&1 | FileCheck %s --check-prefix=STALE

