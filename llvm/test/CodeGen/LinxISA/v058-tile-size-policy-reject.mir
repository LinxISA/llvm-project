# RUN: not --crash llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance -o - %s 2>&1 | FileCheck %s

# CHECK: SizeCode outside 128B..64KB policy

--- |
  define i64 @tile_size_policy_reject(ptr %a, ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_size_policy_reject
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    liveins: $r3, $r4

    $tile0 = PSEUDO_TLSU_TLOAD $r3, 0
    $tile1 = COPY killed $tile0
    PSEUDO_TLSU_TSTORE killed $r4, killed $tile1, 6
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
