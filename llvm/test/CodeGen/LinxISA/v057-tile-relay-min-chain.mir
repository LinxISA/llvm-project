# RUN: llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance -o - %s | FileCheck %s

# CHECK-LABEL: name: tile_relay_chain
# CHECK: bb.0:
# CHECK: $tile2 = PSEUDO_TMA_TMOV $tile0, 8, 17, 0, 0, 0, 1
# CHECK-NOT: $tile1 = PSEUDO_TMA_TMOV
# CHECK-NOT: = COPY

--- |
  define i64 @tile_relay_chain(ptr %a, ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_relay_chain
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    liveins: $r3, $r4

    $tile0 = PSEUDO_TMA_TLOAD $r3, 8
    $tile1 = COPY killed $tile0
    $tile2 = COPY killed $tile1
    PSEUDO_TMA_TSTORE killed $r4, killed $tile2, 8
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
