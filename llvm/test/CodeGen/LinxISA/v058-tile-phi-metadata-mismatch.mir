# RUN: not --crash llc -mtriple=linx64 -run-pass=linx-tile-ssa-balance -o - %s 2>&1 | FileCheck %s

# CHECK: LinxISATileSSABalance: tile COPY metadata mismatch across CFG edges
# CHECK: TSize mismatch

--- |
  define i64 @tile_phi_metadata_mismatch(i64 %cond, ptr %a, ptr %b, ptr %out) {
  entry:
    ret i64 0
  }
...
---
name:            tile_phi_metadata_mismatch
alignment:       2
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
  - { reg: '$r4', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
  isCalleeSavedInfoValid: true
fixedStack:      []
stack:           []
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3, $r4, $r5

    $tile0 = PSEUDO_TLSU_TLOAD killed $r3, 6
    $tile1 = PSEUDO_TLSU_TLOAD killed $r4, 5
    BNE killed $r2, $r0, %bb.1
    JUMP %bb.2

  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $tile0

    $tile2 = COPY killed $tile0
    JUMP %bb.3

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $tile1

    $tile2 = COPY killed $tile1
    JUMP %bb.3

  bb.3:
    liveins: $tile2, $r5, $r3

    PSEUDO_TLSU_TSTORE killed $r5, killed $tile2, 6
    $r2 = ADDIri $r0, 0
    PSEUDO_RET implicit $r10, implicit $r2, implicit $r3
...
