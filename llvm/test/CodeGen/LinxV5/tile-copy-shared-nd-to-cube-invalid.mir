# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos %t/unknown.mir -o /dev/null 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos %t/conflict.mir -o /dev/null 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos %t/carrier.mir -o /dev/null 2>&1 | FileCheck %s
# CHECK: cannot prove a complete Local tile descriptor for COPY/PHI

#--- unknown.mir
--- |
  define void @unknown() { ret void }
...
---
name: unknown
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"BSTART.TMOV DTYPE_NONE\0AB.DATR ND2M32, DTYPE_NONE, Zero\0AB.DIM zero, 3, ->lb0\0AB.DIM zero, 19, ->lb1\0AB.IOS ${1:S}, mask=1111\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 25, 720906, def $tile_t1, 655369, $shared_s0, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...

#--- conflict.mir
--- |
  define void @conflict() { ret void }
...
---
name: conflict
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $tile_u1
    SETC_EQ $r0, $r0, implicit-def $carg
    PseudoBRCondCARG %bb.1, implicit $carg
    PseudoBR %bb.2
  bb.1:
    successors: %bb.3
    liveins: $tile_u1
    INLINEASM &"BSTART.TMOV U32\0AB.DATR M322ND, DTYPE_NONE, Zero\0AB.IOS mask=1111, ->${0:S}<512B>\0AB.IOT $1, mask=1111, last\0A", 25, 655370, def $shared_s0, 720905, $tile_u1
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $tile_u1
    INLINEASM &"BSTART.TMOV U16\0AB.DATR M162ND, DTYPE_NONE, Zero\0AB.IOS mask=1111, ->${0:S}<512B>\0AB.IOT $1, mask=1111, last\0A", 25, 655370, def $shared_s0, 720905, $tile_u1
    PseudoBR %bb.3
  bb.3:
    liveins: $shared_s0
    INLINEASM &"BSTART.TMOV DTYPE_NONE\0AB.DATR ND2M32, DTYPE_NONE, Zero\0AB.DIM zero, 3, ->lb0\0AB.DIM zero, 19, ->lb1\0AB.IOS ${1:S}, mask=1111\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 25, 720906, def $tile_t1, 655369, $shared_s0, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...

#--- carrier.mir
--- |
  define void @carrier() { ret void }
...
---
name: carrier
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = PseudoTCI_EW_Row_SizeI $r0, 1, $r0, 128, 17, 0, 3, $r0, $r0, 128
    INLINEASM &"BSTART.TMOV DTYPE_NONE\0AB.DATR M162ND, DTYPE_NONE, Zero\0AB.IOS mask=1111, ->${0:S}<512B>\0AB.IOT $1, mask=1111, last\0A", 25, 655370, def $shared_s0, 720905, $tile_u1
    INLINEASM &"BSTART.TMOV DTYPE_NONE\0AB.DATR ND2M16, DTYPE_NONE, Zero\0AB.DIM zero, 17, ->lb0\0AB.DIM zero, 11, ->lb1\0AB.IOS ${1:S}, mask=1111\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 25, 720906, def $tile_t1, 655369, $shared_s0, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
