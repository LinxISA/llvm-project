# RUN: llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=true -o - %s | FileCheck %s
#
# Reduction B.DIM describes the source. Typed copies must use the published
# result geometry and (for ARGMAX) U32 dtype. NORM row results have one
# physical column; CUBE row results preserve source columns. Column results
# have one valid row, with CUBE columns rounded to destination CELL width.
# CHECK-LABEL: name: row_sum_norm
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 3, 1, 25, 0
# CHECK-LABEL: name: row_max_norm
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 16, 1, 1, 0
# CHECK-LABEL: name: row_argmax_norm
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 1, 1, 25, 0
# CHECK-LABEL: name: col_sum_norm
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 3, 1, 8, 25, 0
# CHECK-LABEL: name: row_sum_m32
# CHECK: $tile_t2 = PseudoTCOPYDesc 3, $tile_t1, 1, 32, 4, 25, 29
# CHECK-LABEL: name: row_argmax_m16
# CHECK: $tile_t2 = PseudoTCOPYDesc 3, $tile_t1, 1, 16, 8, 25, 31
# CHECK-LABEL: name: col_sum_m16
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 3, 1, 4, 26, 31
# CHECK-LABEL: name: row_sum_operand
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 1, 1, 25, 0
--- |
  define void @row_sum_norm() { ret void }
  define void @row_max_norm() { ret void }
  define void @row_argmax_norm() { ret void }
  define void @col_sum_norm() { ret void }
  define void @row_sum_m32() { ret void }
  define void @row_argmax_m16() { ret void }
  define void @col_sum_m16() { ret void }
  define void @row_sum_operand() { ret void }
...
---
name: row_sum_norm
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 64, U32\0AB.DATR NORM, Null\0AB.DIM zero, 128, ->lb0\0AB.DIM zero, 3, ->lb1\0AB.DIM zero, 128, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: row_max_norm
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL TROWMAX, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 32, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 32, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: row_argmax_norm
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.SFU TROWARGMAX, S64\0AB.DATR NORM, Null\0AB.DIM zero, 128, ->lb0\0AB.DIM zero, 1, ->lb1\0AB.DIM zero, 128, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_sum_norm
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL TCOLSUM, U32\0AB.DATR NORM, Null\0AB.DIM zero, 3, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: row_sum_m32
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL TROWSUM, U32\0AB.DATR CUBE_M32, Null\0AB.DIM zero, 4, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.DIM zero, 4, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: row_argmax_m16
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 76, U8\0AB.DATR CUBE_M16, Null\0AB.DIM zero, 6, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_sum_m16
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.SFU TCOLSUM, U16\0AB.DATR CUBE_M16, Null\0AB.DIM zero, 3, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: row_sum_operand
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL ${3:c}, U32\0AB.DATR NORM, Null\0AB.DIM zero, 128, ->lb0\0AB.DIM zero, 1, ->lb1\0AB.DIM zero, 128, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1, 13, 64
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
