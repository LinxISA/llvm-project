# RUN: llc -mtriple=linx64v5 -run-pass=postrapseudos -linxv5-enable-generic-element=true %s -o - | FileCheck %s

# Assembler-accepted LB case/whitespace must not turn explicit dimensions
# into the architectural omitted-dimension default (one).
# CHECK-LABEL: name: lower
# CHECK: $tile_t1 = PseudoTCOPYDesc 7, $tile_u1, 2048, 1, 2048, 25, 0
# CHECK-LABEL: name: upper
# CHECK: $tile_t1 = PseudoTCOPYDesc 7, $tile_u1, 2048, 1, 2048, 25, 0
# CHECK-LABEL: name: immediate
# CHECK: $tile_t1 = PseudoTCOPYDesc 7, $tile_u1, 2048, 1, 2048, 25, 0
# CHECK-LABEL: name: space
# CHECK: $tile_t1 = PseudoTCOPYDesc 7, $tile_u1, 2048, 1, 2048, 25, 0
# CHECK-LABEL: name: dynamic_upper
# CHECK: $tile_t1 = PseudoTCOPYDesc 7, $tile_u1, $r17, 1, $r17, 25, 0
--- |
  define void @lower() { ret void }
  define void @upper() { ret void }
  define void @immediate() { ret void }
  define void @space() { ret void }
  define void @dynamic_upper() { ret void }
...
---
name: lower
tracksRegLiveness: true
body: |
  bb.0:
    INLINEASM &"BSTART.TEPL 102, U32\0AB.DIM zero, 2048, ->lb0\0AB.DIM zero, 1, ->lb1\0AB.DIM zero, 2048, ->lb2\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9, 720906, def $tile_u1, 13, 7
    $tile_t1 = COPY $tile_u1
    PseudoRET
...
---
name: upper
tracksRegLiveness: true
body: |
  bb.0:
    INLINEASM &"BSTART.TEPL 102, U32\0AB.DIM zero, 2048, ->LB0\0AB.DIM zero, 1, ->LB1\0AB.DIM zero, 2048, ->LB2\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9, 720906, def $tile_u1, 13, 7
    $tile_t1 = COPY $tile_u1
    PseudoRET
...
---
name: immediate
tracksRegLiveness: true
body: |
  bb.0:
    INLINEASM &"BSTART.TEPL 102, U32\0AB.DIM ZERO , ${2:c}, -> \09Lb0\0AB.DIM zero, 1, -> \09Lb1\0AB.DIM ZERO , ${2:c}, -> \09Lb2\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9, 720906, def $tile_u1, 13, 7, 13, 2048
    $tile_t1 = COPY $tile_u1
    PseudoRET
...
---
name: space
tracksRegLiveness: true
body: |
  bb.0:
    INLINEASM &"BSTART.TEPL 102, U32\0AB.DIM zero, 2048, -> \09Lb0\0AB.DIM zero, 1, -> \09Lb1\0AB.DIM zero, 2048, -> \09Lb2\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9, 720906, def $tile_u1, 13, 7
    $tile_t1 = COPY $tile_u1
    PseudoRET
...
---
name: dynamic_upper
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r17
    INLINEASM &"BSTART.TEPL 102, U32\0AB.DIM $1, 0, ->LB0\0AB.DIM zero, 1, ->LB1\0AB.DIM $1, 0, ->LB2\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_u1, 2293769, $r17, 13, 7
    $tile_t1 = COPY $tile_u1
    PseudoRET
...
