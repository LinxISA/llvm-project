# RUN: llc -mtriple=linx64v5-unknown-linux-musl -linxv5-enable-tile-clock-hand=false -run-pass=linxv5-clockhands %s -o - | FileCheck %s --check-prefix=CLASS
# RUN: llc -mtriple=linx64v5-unknown-linux-musl -linxv5-enable-tile-clock-hand=false -verify-machineinstrs -run-pass=linxv5-clockhands,greedy,virtregrewriter %s -o - | FileCheck %s --check-prefix=ALLOC
# RUN: llc -mtriple=linx64v5-unknown-linux-musl -linxv5-enable-tile-clock-hand=false -run-pass=linxv5-clockhands %s -o - | sed 's/tile_umn/tile_nr/g' > %t.mir
# RUN: llc -mtriple=linx64v5-unknown-linux-musl -verify-machineinstrs -run-pass=greedy,virtregrewriter,linxv5-tile-fixup,prologepilog %t.mir -o - | FileCheck %s --check-prefix=SPILL
