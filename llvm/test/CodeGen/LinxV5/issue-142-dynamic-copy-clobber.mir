# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos -o - %s 2>&1 | FileCheck %s
# CHECK: Local tile COPY dimension value is no longer available
--- |
  define void @clobbered_dimension() { ret void }
...
---
name: clobbered_dimension
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    INLINEASM &"BSTART.TEPL 0, FP32\0AB.DATR CUBE_M32, Null\0AB.DIM $1, 0, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.DIM zero, 256, ->lb2\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 2621449, $r2, 13, 9
    $r2 = ADDI $r0, 7
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
