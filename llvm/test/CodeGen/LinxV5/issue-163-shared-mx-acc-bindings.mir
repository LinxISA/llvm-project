    $tile_u1 = PseudoTCI_EW_Row_SizeI $r0, 16, $r0, 64, 1, 31, 6, $r0, $r0, 64
    INLINEASM &"BSTART.CUBE TMATMULMX.ACC, E4M3\0AB.DATR E4M3, byte0, Zero, RNONE, NOSAT\0AB.FPATR 0, 0, 0, 0, 0, 0, 0, 0, 0, ${6:c}\0AB.DIM zero, 64, ->lb0\0AB.DIM zero, 64, ->lb1\0AB.DIM zero, 64, ->lb2\0AB.IOS ${2:S}, mask=1111\0AB.IOS ${3:S}, mask=1111\0AB.IOS ${4:S}, mask=1111\0AB.IOS ${5:S}, mask=1111\0AB.IOT $1, mask=1111\0A.if ${6:c}\0AB.IOT $1, mask=1111\0A.endif\0AB.IOT mask=1111, last, ->$0<${7:Z}>\0A", 25, 786443, def early-clobber $tile_t1, 786441, $tile_u1, 655369, $shared_s0, 655369, $shared_s1, 655369, $shared_s4, 655369, $shared_s5, 13, 0, 13, 6
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
