# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl -run-pass=linxv5-clockhands -o /dev/null %t-negative.mir 2>&1 | FileCheck %s
#
# Partial writes, calls, ordinary addressable stack objects and volatile
# reloads must never retain the private exact-spill counter proof.
# CHECK: LLVM ERROR: B.ASSEMBLE continuation may execute without an OPEN parent
