# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -run-pass=linxv5-treg-to-offset -o /dev/null %s 2>&1 | FileCheck %s
# A real copy publishes an ordinary value, not the original INIT identity.
# Joining copied and original CLOSED values produces conflicting identities at
# the CFG join, so no single parent-relative source distance is valid.
# CHECK: LLVM ERROR: B.ASSEMBLE parent has conflicting relative distances at a CFG join
--- |
  define void @closed_copy_identity_join() { ret void }
...
---
name: closed_copy_identity_join
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r3
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 2, 13, 1, 13, 0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, $tile_t1, 720905, $tile_u1, 13, 0, 13, 1
    BEQ $r2, $r0, %bb.1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.3
    liveins: $r3, $tile_t1
    $tile_t1 = PseudoTCOPYDesc 2, $tile_t1, 2, 32, 2, 17, 29
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r3, $tile_t1
    PseudoBR %bb.3
  bb.3:
    liveins: $r3, $tile_t1
    INLINEASM &"BSTART.TLSU TSTORE, 17\0AB.DATR M322ND.normal, Null\0AB.DIM zero, 2, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOR [$0,zero], []\0A", 1, 2293769, $r3, 720905, $tile_t1
    PseudoRET
...
