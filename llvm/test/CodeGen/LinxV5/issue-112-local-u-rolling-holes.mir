# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-treg-to-offset -o - %s | FileCheck %s
# CHECK-LABEL: name: local_u_rolling_holes
# CHECK: $tile_u = PseudoTCOPYDesc 3, $tile_uos{{[0-9]+}}, 4, 32, 4, 25, 29
# CHECK-NOT: PseudoTCOPYDesc {{.*}}$tile_u{{[0-9]+}}
# CHECK: PseudoRET
--- |
  define void @local_u_rolling_holes() { ret void }
...
---
name: local_u_rolling_holes
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r2
    $tile_u5 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u2 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u6 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u3 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u4 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3, %bb.2
    liveins: $r2, $tile_u1, $tile_u2, $tile_u3, $tile_u4, $tile_u5, $tile_u6
    INLINEASM &"consume $0", 1, 720905, $tile_u1
    INLINEASM &"consume $0", 1, 720905, $tile_u2
    INLINEASM &"consume $0", 1, 720905, $tile_u3
    INLINEASM &"consume $0", 1, 720905, $tile_u4
    INLINEASM &"consume $0", 1, 720905, $tile_u5
    INLINEASM &"consume $0", 1, 720905, $tile_u6
    BEQ $r2, $r0, %bb.3
    PseudoBR %bb.2
  bb.2:
    successors: %bb.1
    liveins: $r2, $tile_u1, $tile_u2, $tile_u3, $tile_u4, $tile_u5, $tile_u6
    $tile_u3 = PseudoTCOPYDesc 3, $tile_u3, 4, 32, 4, 25, 29
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u4 = PseudoTCOPYDesc 3, $tile_u4, 4, 32, 4, 25, 29
    $tile_u1 = PseudoTCOPYDesc 3, $tile_u1, 4, 32, 4, 25, 29
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u2 = PseudoTCOPYDesc 3, $tile_u2, 4, 32, 4, 25, 29
    $tile_u6 = PseudoTCOPYDesc 3, $tile_u6, 4, 32, 4, 25, 29
    dead $tile_u16 = PseudoTCI_EW_SizeI $r0, 32, $r0, 4, 25, 29, 3, $r0, $r0
    $tile_u5 = PseudoTCOPYDesc 3, $tile_u5, 4, 32, 4, 25, 29
    PseudoBR %bb.1
  bb.3:
    liveins: $r2, $tile_u1, $tile_u2, $tile_u3, $tile_u4, $tile_u5, $tile_u6
    INLINEASM &"consume $0", 1, 720905, $tile_u1
    INLINEASM &"consume $0", 1, 720905, $tile_u2
    INLINEASM &"consume $0", 1, 720905, $tile_u3
    INLINEASM &"consume $0", 1, 720905, $tile_u4
    INLINEASM &"consume $0", 1, 720905, $tile_u5
    INLINEASM &"consume $0", 1, 720905, $tile_u6
    PseudoRET
...
