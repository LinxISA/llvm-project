# RUN: llc -mtriple=linx64v5-unknown-linux-musl -run-pass=linxv5-clockhands -o - %s | FileCheck %s
# RUN: %python -c 'import pathlib,sys; s=pathlib.Path(sys.argv[1]).read_text(); pathlib.Path(sys.argv[2]).write_text(s.replace("size: 8", "size: 16").replace("\n    $r5 = LDI", "\n    SDI $r4, %%stack.0, 1 :: (store (s64) into %%stack.0 + 8)\n    SWI $r4, $r0, 0 :: (store (s32))\n    $r5 = LDI", 1))' %s %t-separated.mir
# RUN: llc -mtriple=linx64v5-unknown-linux-musl -run-pass=linxv5-clockhands -o - %t-separated.mir | FileCheck %s
#
# Register allocation spills the phase counter while unrelated scalar work
# reuses its register. Only an exact private eight-byte reload preserves it.
# Missing ranges must not fabricate an OPEN generation on the first iteration.
# CHECK-LABEL: name: assemble_parent_phase_spill
# CHECK: class: tile_tr
--- |
  define void @assemble_parent_phase_spill() { ret void }
...
---
name: assemble_parent_phase_spill
tracksRegLiveness: true
registers:
  - { id: 0, class: tile_abs }
  - { id: 1, class: tile_abs }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1
    %1:tile_abs = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    %0:tile_abs = IMPLICIT_DEF
    $r4 = ORI $r0, 0
    PseudoBR %bb.1
  bb.1:
    successors: %bb.2, %bb.3
    liveins: $r4
    SDI $r4, %stack.0, 0 :: (store (s64) into %stack.0)
    $r4 = ORI $r0, 99
    $r5 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    SETC_EQI_BR $r5, 0, %bb.2
    PseudoBR %bb.3
  bb.2:
    successors: %bb.6
    liveins: $r5
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def %0, 720905, %1, 13, 2, 13, 1, 13, 0
    PseudoBR %bb.6
  bb.3:
    successors: %bb.4, %bb.5
    liveins: $r5
    SETC_EQI_BR $r5, 3, %bb.5
    PseudoBR %bb.4
  bb.4:
    successors: %bb.6
    liveins: $r5
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 0, 1\0A", 9, 720905, %0, 720905, %1, 13, 0, 13, 0
    PseudoBR %bb.6
  bb.5:
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, %0, 720905, %1, 13, 0, 13, 1
    PseudoRET
  bb.6:
    successors: %bb.1
    liveins: $r5
    $r4 = ADDI $r5, 1
    PseudoBR %bb.1
...
