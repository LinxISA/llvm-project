# RUN: llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -o - %s | FileCheck %s
#
# Force a physical COPY independently of PHI coalescing/queue normalization.
# Complete dtype, layout, valid geometry, physical pitch and capacity survive.
# CHECK-LABEL: name: m32_fp16
# CHECK: $tile_t2 = PseudoTCOPYDesc 2, $tile_t1, 4, 32, 4, 4, 29
# CHECK-NOT: PseudoTCOPY 
# CHECK-LABEL: name: m32_one_col_fp16
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 32, 1, 4, 29
# CHECK-NOT: PseudoTCOPY 
# CHECK-LABEL: name: m16_fp16
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 4, 8, 4, 4, 31
# CHECK-NOT: PseudoTCOPY 
# CHECK-LABEL: name: norm_u32
# CHECK: $tile_t2 = PseudoTCOPYDesc 3, $tile_t1, 128, 1, 128, 25, 0
# CHECK-NOT: PseudoTCOPY 
--- |
  define void @m32_fp16() { ret void }
  define void @m32_one_col_fp16() { ret void }
  define void @m16_fp16() { ret void }
  define void @norm_u32() { ret void }
...
---
name: m32_fp16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    $tile_t1 = PseudoTEXPANDS_Row_SizeI $r0, 32, $r0, 4, 4, 29, 2, $r2, 4
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: m32_one_col_fp16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    $tile_t1 = PseudoTEXPANDS_Row_SizeI $r0, 32, $r0, 1, 4, 29, 1, $r2, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: m16_fp16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    $tile_t1 = PseudoTEXPANDS_Row_SizeI $r0, 8, $r0, 4, 4, 31, 1, $r2, 4
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: norm_u32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    $tile_t1 = PseudoTEXPANDS_Row_SizeI $r0, 1, $r0, 128, 25, 0, 3, $r2, 128
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
