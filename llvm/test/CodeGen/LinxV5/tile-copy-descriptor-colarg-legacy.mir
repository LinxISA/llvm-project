# RUN: llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=false -o - %s | FileCheck %s
#
# Nonzero B.DIM register offsets require the legacy descriptor parser. Zero
# bases remain static. Runtime column offsets must survive in a U32 result,
# while source rows and physical columns are replaced before runtime analysis.
# CHECK-LABEL: name: col_argmax_legacy
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 16, 1, 16, 25, 0
# CHECK-LABEL: name: col_argmin_legacy
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 16, 1, 16, 25, 0
# CHECK-LABEL: name: col_argmax_dynamic_legacy
# CHECK: $tile_t2 = PseudoTMOV_SizeI $r17, 1, $r0, 1, $r0, 4, 25, 2, $tile_t1, 31, 0, 31
# CHECK-LABEL: name: col_argmin_dynamic_legacy
# CHECK: $tile_t2 = PseudoTMOV_SizeI $r17, 2, $r0, 1, $r0, 4, 25, 3, $tile_t1, 29, 0, 31
# CHECK-LABEL: name: col_argmax_static_columns_dynamic_source_legacy
# CHECK: $tile_t2 = PseudoTCOPYDesc 2, $tile_t1, 3, 1, 4, 25, 31
--- |
  define void @col_argmax_legacy() { ret void }
  define void @col_argmin_legacy() { ret void }
  define void @col_argmax_dynamic_legacy() { ret void }
  define void @col_argmin_dynamic_legacy() { ret void }
  define void @col_argmax_static_columns_dynamic_source_legacy() { ret void }
...
---
name: col_argmax_legacy
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR NORM, Null\0AB.DIM $3, 16, ->lb0\0AB.DIM $3, 16, ->lb1\0AB.DIM $3, 16, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1, 2293769, $r0
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_argmin_legacy
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 93, FP32\0AB.DATR NORM, Null\0AB.DIM $3, 16, ->lb0\0AB.DIM $3, 16, ->lb1\0AB.DIM $3, 16, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1, 2293769, $r0
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_argmax_dynamic_legacy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r17, $r18, $r19
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M16, Null\0AB.DIM $3, 1, ->lb0\0AB.DIM $4, 3, ->lb1\0AB.DIM $5, 2, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 2, 2293769, $r17, 2293769, $r18, 2293769, $r19
    $r18 = ORI $r0, 7
    $r19 = ORI $r0, 8
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_argmin_dynamic_legacy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r17, $r18, $r19
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 93, FP16\0AB.DATR CUBE_M32, Null\0AB.DIM $3, 2, ->lb0\0AB.DIM $4, 3, ->lb1\0AB.DIM $5, 2, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3, 2293769, $r17, 2293769, $r18, 2293769, $r19
    $r18 = ORI $r0, 7
    $r19 = ORI $r0, 8
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: col_argmax_static_columns_dynamic_source_legacy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r18, $r19
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M16, Null\0AB.DIM $3, 3, ->lb0\0AB.DIM $4, 1, ->lb1\0AB.DIM $5, 2, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 2, 2293769, $r0, 2293769, $r18, 2293769, $r19
    $r18 = ORI $r0, 7
    $r19 = ORI $r0, 8
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
