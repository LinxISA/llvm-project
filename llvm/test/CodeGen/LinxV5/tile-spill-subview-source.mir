# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o - %s | FileCheck %s

# CHECK-LABEL: name: subview_source
# CHECK: PseudoTSpillDesc killed $tile_n1, %stack.0, 1, 32, 2, 5, 29, 1
# CHECK: $tile_n2 = PseudoTReloadDesc %stack.0, 1, 32, 2, 5, 29, 1
# CHECK-LABEL: name: subview_source_copy
# CHECK: PseudoTSpillDesc killed $tile_n2, %stack.0, 1, 32, 2, 5, 29, 1

--- |
  define void @subview_source() { ret void }
  define void @subview_source_copy() { ret void }
...
---
name: subview_source
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 8, alignment: 8, stack-id: default }
body: |
  bb.0:
    liveins: $tile_n1, $r15
    INLINEASM &"BSTART.TEPL ${9:c}, ${1:D}\0A.if ${10:c} == 29\0AB.DATR CUBE_M32, Null\0A.elseif ${10:c} == 31\0AB.DATR CUBE_M16, Null\0A.endif\0AB.DIM zero, ${2:c}, ->lb0\0AB.DIM zero, ${3:c}, ->lb1\0AB.DIM zero, ${4:c}, ->lb2\0AB.IOT $5, mask=1111, last, ->$0<${6:Z}>\0AB.SUBVIEW 0, $7, 0, 1\0AB.IOR [$8],[]\0A", 9, 720906, def $tile_n1, 13, 5, 13, 1, 13, 32, 13, 2, 720905, killed $tile_n1, 13, 1, 2293769, $r0, 2293769, $r15, 13, 34, 13, 29
    PseudoTSpill killed $tile_n1, %stack.0 :: (store (s64) into %stack.0)
    $tile_n2 = PseudoTReload %stack.0 :: (load (s64) from %stack.0)
    PseudoRET
...
---
name: subview_source_copy
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 8, alignment: 8, stack-id: default }
body: |
  bb.0:
    liveins: $tile_n1, $r15
    INLINEASM &"BSTART.TEPL ${9:c}, ${1:D}\0A.if ${10:c} == 29\0AB.DATR CUBE_M32, Null\0A.elseif ${10:c} == 31\0AB.DATR CUBE_M16, Null\0A.endif\0AB.DIM zero, ${2:c}, ->lb0\0AB.DIM zero, ${3:c}, ->lb1\0AB.DIM zero, ${4:c}, ->lb2\0AB.IOT $5, mask=1111, last, ->$0<${6:Z}>\0AB.SUBVIEW 0, $7, 0, 1\0AB.IOR [$8],[]\0A", 9, 720906, def $tile_n1, 13, 5, 13, 1, 13, 32, 13, 2, 720905, killed $tile_n1, 13, 1, 2293769, $r0, 2293769, $r15, 13, 34, 13, 29
    $tile_n2 = COPY killed $tile_n1
    PseudoTSpill killed $tile_n2, %stack.0 :: (store (s64) into %stack.0)
    PseudoRET
...
