stack:
  - { id: 0, type: spill-slot, offset: 0, size: 512, alignment: 256, stack-id: default }
body: |
  bb.0:
    liveins: $tile_u1
    PseudoTSpillDesc killed $tile_u1, %stack.0, 4, 32, 4, 25, 29, 3 :: (store (s128) into %stack.0, align 256)
    PseudoRET
...
