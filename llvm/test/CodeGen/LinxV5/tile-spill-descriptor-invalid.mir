body: |
  bb.0:
    INLINEASM &"B.ASSEMBLE 0, 1, zero, 0, 1", 9, 720906, def $tile_u1
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s4096) into %stack.0, align 256)
    PseudoRET
...
