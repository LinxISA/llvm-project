# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/no-spill.mir 2>&1 | FileCheck %s --check-prefix=REACH
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/one-arm.mir 2>&1 | FileCheck %s --check-prefix=REACH
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/conflict.mir 2>&1 | FileCheck %s --check-prefix=REACH
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/clobber.mir 2>&1 | FileCheck %s --check-prefix=REACH
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/wrong-fi.mir 2>&1 | FileCheck %s --check-prefix=MMO
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/wrong-direction.mir 2>&1 | FileCheck %s --check-prefix=WRONG-DIRECTION
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/multiple-mmos.mir 2>&1 | FileCheck %s --check-prefix=MMO-COUNT
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/non-fixed.mir 2>&1 | FileCheck %s --check-prefix=MMO
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/nonzero-offset.mir 2>&1 | FileCheck %s --check-prefix=MMO
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/bad-extent.mir 2>&1 | FileCheck %s --check-prefix=EXTENT
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/size-zero.mir 2>&1 | FileCheck %s --check-prefix=SIZE
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/size-eleven.mir 2>&1 | FileCheck %s --check-prefix=SIZE
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/open-assemble.mir 2>&1 | FileCheck %s --check-prefix=SOURCE
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/subview.mir 2>&1 | FileCheck %s --check-prefix=SOURCE
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup -o /dev/null %t/shared.mir 2>&1 | FileCheck %s --check-prefix=SHARED
# REACH: LLVM ERROR: raw Tile reload has no exact reaching spill descriptor
# MMO: LLVM ERROR: raw Tile spill MMO identity or direction disagrees with its FI
# WRONG-DIRECTION: Bad machine code: Missing mayLoad flag
# MMO-COUNT: LLVM ERROR: raw Tile spill requires exactly one fixed-stack MMO
# EXTENT: LLVM ERROR: raw Tile spill descriptor disagrees with its MMO extent
# SIZE: LLVM ERROR: raw Tile spill SizeCode must be 1..10
# SOURCE: LLVM ERROR: raw Tile spill source is OPEN, alias-bearing, or unresolved
# SHARED: Bad machine code: Illegal physical register for instruction
#--- no-spill.mir
--- |
  define void @no_spill() { ret void }
...
---
name: no_spill
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 512, alignment: 256,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    $tile_n1 = PseudoTReload %stack.0 :: (load (s4096) from %stack.0, align 256)
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
#--- one-arm.mir
--- |
  define void @one_arm(i1 %cond) { ret void }
...
---
name: one_arm
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 512, alignment: 256,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $r2
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 25, 3, 21, 0, $r2
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s4096) into %stack.0, align 256)
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3(0x80000000)
    PseudoBR %bb.3
  bb.3:
    $tile_n1 = PseudoTReload %stack.0 :: (load (s4096) from %stack.0, align 256)
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
#--- conflict.mir
--- |
  define void @conflict() { ret void }
...
---
name: conflict
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 512, alignment: 256,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $r3
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 25, 3, 21, 0, $r3
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s4096) into %stack.0, align 256)
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $r3
    $tile_m1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 17, 3, 21, 0, $r3
    PseudoTSpill killed $tile_m1, %stack.0 :: (store (s4096) into %stack.0, align 256)
    PseudoBR %bb.3
  bb.3:
    $tile_n1 = PseudoTReload %stack.0 :: (load (s4096) from %stack.0, align 256)
    PseudoRET
...
#--- clobber.mir
--- |
  define void @clobber() { ret void }
...
---
name: clobber
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 512, alignment: 256,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $r2
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 25, 3, 21, 0, $r2
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s4096) into %stack.0, align 256)
    INLINEASM &"", 17 :: (store (s32) into %stack.0)
    $tile_t1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 25, 3, 21, 0, $r2
    $tile_n1 = PseudoTReload %stack.0 :: (load (s4096) from %stack.0, align 256)
    PseudoRET
...
#--- wrong-fi.mir
--- |
  define void @wrong_fi() { ret void }
...
---
name: wrong_fi
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 512, alignment: 256, stack-id: default }
  - { id: 1, type: spill-slot, offset: 0, size: 512, alignment: 256, stack-id: default }
body: |
  bb.0:
    liveins: $r2
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 4, $r0, 32, $r0, 4, 25, 3, 21, 0, $r2
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s4096) into %stack.1, align 256)
    PseudoRET
...
