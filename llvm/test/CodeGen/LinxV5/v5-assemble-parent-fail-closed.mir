#--- unsafe-parent-rotation.mir
--- |
  define void @unsafe_parent_rotation_must_fail_closed() { ret void }
...
---
name:            unsafe_parent_rotation_must_fail_closed
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $r4 = ORI $r0, 0
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 2, 4, 29, 1, $r0, $r0
    $tile_u3 = IMPLICIT_DEF
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)
    liveins: $r4, $tile_u1, $tile_u2, $tile_u3
    $tile_u1 = PseudoTCOPYDesc 1, $tile_u1, 2, 32, 2, 4, 29
    BEQ $r4, $r0, %bb.2
    PseudoBR %bb.3
  bb.2:
    successors: %bb.4(0x80000000)
    liveins: $r4, $tile_u1
    INLINEASM &"BSTART.TEPL 27, 4\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 2, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.DIM zero, 2, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def $tile_u2, 720905, $tile_u1, 13, 1, 13, 1, 13, 0
    $tile_u3 = PseudoTCI_EW_SizeI $r0, 32, $r0, 2, 4, 29, 1, $r0, $r0
    PseudoBR %bb.4
  bb.4:
    successors: %bb.1(0x80000000)
    liveins: $r4, $tile_u1, $tile_u2, $tile_u3
    $r4 = ADDI $r4, 1
    PseudoBR %bb.1
  bb.3:
    liveins: $tile_u1, $tile_u2, $tile_u3
    INLINEASM &"BSTART.TEPL 27, 4\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 2, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.DIM zero, 2, ->lb2\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, $tile_u2, 720905, $tile_u1, 13, 0, 13, 1
    INLINEASM &"BSTART.TLSU TSTORE, 4\0AB.DATR M322ND.normal, Null\0AB.DIM zero, 2, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOR [$0,zero], []\0A", 1, 2293769, $r0, 720905, $tile_u3
    PseudoRET
...
