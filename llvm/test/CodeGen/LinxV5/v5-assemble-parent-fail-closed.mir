# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/stale-implicit-def.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OPEN
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/unresolved-init.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CONTROL
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/unresolved-last.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CONTROL
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/one-arm-last-common-last.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CONTINUATION
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/already-closed-continuation.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CONTINUATION
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/overlapping-spill-write.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OPEN
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/unknown-spill-store.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OPEN
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/non-spill-stack-object.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OPEN
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -verify-machineinstrs -run-pass=linxv5-treg-to-offset \
# RUN:   -o /dev/null %t/unsafe-parent-rotation.mir 2>&1 \
# RUN:   | FileCheck %s --check-prefix=ROTATION
#
# An unmodeled implicit register definition invalidates an earlier known
# scalar value.  The conditional branch must explore both successors,
# including the path that reaches the ordinary use while the parent is OPEN.
#
# OPEN: LLVM ERROR: cannot use an OPEN B.ASSEMBLE parent as an ordinary tile source before LAST
# CONTROL: LLVM ERROR: B.ASSEMBLE Init/Last controls must be immediate operands
# CONTINUATION: LLVM ERROR: B.ASSEMBLE continuation requires one exact OPEN parent epoch at a uniform relative distance
# ROTATION: LLVM ERROR: cannot synchronize Local tile queue without copying an OPEN B.ASSEMBLE parent

#--- stale-implicit-def.mir
--- |
  define void @stale_implicit_def_must_not_prune_open_path(i64 %unknown) { ret void }
...
---
name:            stale_implicit_def_must_not_prune_open_path
alignment:       2
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
  - { reg: '$r3', virtual-reg: '' }
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3
    $r4 = ORI $r0, 0
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 5, 13, 1, 13, 0
    C_SETC_TGT $r2, implicit-def $r4, implicit-def $carg
    BEQ $r4, $r0, %bb.1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $r3, $tile_t1, $tile_u1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, $tile_t1, 720905, $tile_u1, 13, 0, 13, 1
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $r3, $tile_t1
    PseudoBR %bb.3
  bb.3:
    liveins: $r3, $tile_t1
    INLINEASM &"BSTART.TLSU TSTORE, 17\0AB.DATR M322ND.normal, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOR [$0,zero], []\0A", 1, 2293769, $r3, 720905, $tile_t1
    PseudoRET
...

#--- unresolved-init.mir
--- |
  define void @unresolved_assemble_init() { ret void }
...
---
name:            unresolved_assemble_init
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${9:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 5, 13, 1, 13, 0
    PseudoRET
...

