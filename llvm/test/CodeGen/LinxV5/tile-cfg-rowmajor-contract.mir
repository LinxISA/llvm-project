# RUN: split-file %s %t
# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-treg-to-offset %t/good.mir -o /dev/null
# RUN: not llc -mtriple=linx64v5 -run-pass=linxv5-treg-to-offset %t/bad.mir -o /dev/null 2>&1 | FileCheck %s
# CHECK: conflicting Local tile descriptors at COPY/PHI control-flow join

# Equal full U32 RowMajor contracts must join. A true physical-shape mismatch
# must still fail with the normal MachineVerifier enabled.
#--- good.mir
--- |
  define void @loop_probe() { ret void }
...
---
name: loop_probe
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r2, $r3
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 2048, $r0, 1, $r0, 2048, 25, 7, 0, 0, $r2, $r0
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3, $tile_u1
    INLINEASM &"BSTART.TEPL TADD, U32\0AB.DIM zero, 2048, ->LB0\0AB.DIM zero, 1, ->LB1\0AB.DIM zero, 2048, ->LB2\0AB.IOT $1, $2, mask=1111, last, ->$0<${3:Z}>\0A", 9, 720906, def $tile_u1, 720905, killed $tile_u1, 720905, killed $tile_u1, 13, 7
    $r3 = SUBI $r3, 1
    BNE $r3, $r0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $r2, $tile_u1
    PseudoTSTORE_noDsrc_noDdst killed $tile_u1, $r0, 2048, $r0, 1, $r0, 2048, 25, 0, $r2, $r0
    PseudoRET
...
#--- bad.mir
--- |
  define void @loop_probe() { ret void }
...
---
name: loop_probe
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r2, $r3
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 1024, $r0, 1, $r0, 1024, 25, 7, 0, 0, $r2, $r0
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2, $r3, $tile_u1
    INLINEASM &"BSTART.TEPL TADD, U32\0AB.DIM zero, 2048, ->LB0\0AB.DIM zero, 1, ->LB1\0AB.DIM zero, 2048, ->LB2\0AB.IOT $1, $2, mask=1111, last, ->$0<${3:Z}>\0A", 9, 720906, def $tile_u1, 720905, killed $tile_u1, 720905, killed $tile_u1, 13, 7
    $r3 = SUBI $r3, 1
    BNE $r3, $r0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $r2, $tile_u1
    PseudoTSTORE_noDsrc_noDdst killed $tile_u1, $r0, 2048, $r0, 1, $r0, 2048, 25, 0, $r2, $r0
    PseudoRET
...
