# RUN: split-file %s %t
# RUN: llc -mtriple=linx64v5 -verify-machineinstrs -run-pass=postrapseudos -o - %t/good.mir | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos -o /dev/null %t/overwritten-spill.mir 2>&1 | FileCheck %s --check-prefix=BAD
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos -o /dev/null %t/clobber-loop.mir 2>&1 | FileCheck %s --check-prefix=BAD
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos -o /dev/null %t/partial-spill-write.mir 2>&1 | FileCheck %s --check-prefix=BAD
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=postrapseudos -o /dev/null %t/unknown-spill-write.mir 2>&1 | FileCheck %s --check-prefix=BAD
# RUN: not llc -mtriple=linx64v5 -run-pass=postrapseudos -o /dev/null %t/conflicting-constants.mir 2>&1 | FileCheck %s --check-prefix=CONFLICT
#
# A loop must retain its dominating scalar constant. A reload of a private
# spill transports the stored value, while an overwritten slot does not.
# CHECK-LABEL: name: constant_loop
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, 24, 1, 1, 0
# CHECK-LABEL: name: spill_identity
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, $r6, 1, 1, 0
# CHECK-LABEL: name: merged_spill
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, $r6, 1, 1, 0
# CHECK-LABEL: name: merged_spill_through_empty_block
# CHECK: $tile_t2 = PseudoTCOPYDesc 1, $tile_t1, 1, $r6, 1, 1, 0
# BAD: Local tile COPY dimension value is no longer available
# CONFLICT: conflicting Local tile descriptors at COPY/PHI control-flow join
#--- good.mir
--- |
  define void @constant_loop() { ret void }
  define void @spill_identity() { ret void }
  define void @merged_spill() { ret void }
  define void @merged_spill_through_empty_block() { ret void }
...
---
name: constant_loop
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r2
    $r5 = ADDI $r0, 24
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r2, $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    BEQ $r2, $r0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $tile_t1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: spill_identity
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: merged_spill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    $r5 = ADDI $r0, 24
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    $r5 = ADDI $r0, 23
    PseudoBR %bb.3
  bb.3:
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: merged_spill_through_empty_block
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    $r5 = ADDI $r0, 24
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    $r5 = ADDI $r0, 23
    PseudoBR %bb.3
  bb.3:
    successors: %bb.4
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
  bb.4:
    liveins: $r5, $tile_t1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
#--- overwritten-spill.mir
--- |
  define void @overwritten_spill() { ret void }
...
---
name: overwritten_spill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
#--- conflicting-constants.mir
--- |
  define void @conflicting_constants() { ret void }
...
---
name: conflicting_constants
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    $r5 = ADDI $r0, 24
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    $r5 = ADDI $r0, 23
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    PseudoBR %bb.3
  bb.3:
    liveins: $tile_t1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
#--- clobber-loop.mir
--- |
  define void @clobber_loop() { ret void }
...
---
name: clobber_loop
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r2, $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r2, $r5, $tile_t1
    $r5 = ADDI $r5, 1
    BEQ $r2, $r0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $tile_t1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
#--- partial-spill-write.mir
--- |
  define void @partial_spill_write() { ret void }
...
---
name: partial_spill_write
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    SWI $r5, %stack.0, 0 :: (store (s32) into %stack.0)
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
#--- unknown-spill-write.mir
--- |
  define void @unknown_spill_write() { ret void }
...
---
name: unknown_spill_write
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $r5
    INLINEASM &"BSTART.TEPL 59, FP32\0AB.DATR NORM, Null\0AB.DIM zero, 1, ->lb0\0AB.DIM $1, 0, ->lb1\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0AB.IOR [zero],[]\0A", 9, 720906, def $tile_t1, 2293769, $r5, 13, 1
    SDI $r5, %stack.0, 0 :: (store (s64) into %stack.0)
    $r5 = ADDI $r0, 7
    INLINEASM &"", 25
    $r6 = LDI %stack.0, 0 :: (load (s64) from %stack.0)
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
