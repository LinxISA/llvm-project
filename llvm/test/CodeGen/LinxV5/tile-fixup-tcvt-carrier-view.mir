    $tile_t1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 26, 0, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, ${1:D}\0AB.DATR ${2:D}, RNONE\0AB.DIM zero, ${5:c}, ->lb0\0AB.DIM zero, ${6:c}, ->lb1\0AB.DIM zero, ${7:c}, ->lb2\0AB.IOT $3, mask=1111, last, ->$0<${4:Z}>\0A", 9, 786442, def $tile_u1, 13, 4, 13, 5, 786441, $tile_t1, 13, 1, 13, 1, 13, 32, 13, 1
    PseudoTSpill $tile_t1, %stack.0 :: (store (s64) into %stack.0)
    PseudoTSpill $tile_u1, %stack.1 :: (store (s64) into %stack.1)
...

