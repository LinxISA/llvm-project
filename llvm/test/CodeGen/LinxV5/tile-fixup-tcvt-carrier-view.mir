    INLINEASM &"BSTART.TEPL 27, ${1:D}\0AB.DATR ${2:D}, RNONE\0AB.DIM zero, ${5:c}, ->lb0\0AB.DIM zero, ${6:c}, ->lb1\0AB.IOT $3, mask=1111, last, ->$0<${4:Z}>\0A", 9, 786442, def $tile_u1, 13, 1, 13, 5, 786441, $tile_t1, 13, 1, 13, 1, 13, 32
