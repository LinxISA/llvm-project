# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-shared-reuse-finalize %s -o - | FileCheck %s

# CHECK-LABEL: name: local_repeated
# CHECK: B.IOT $0, mask=1111
# CHECK-LABEL: name: local_duplicate
# CHECK: $tile_t1
# CHECK-LABEL: name: loop_liveout
# CHECK: $shared_s0_ru
# CHECK: killed $shared_s0
# CHECK-LABEL: name: branch_liveout
# CHECK: $shared_s0_ru
# CHECK: killed $shared_s0
# CHECK: killed $shared_s0
# CHECK-LABEL: name: tied_definition
# CHECK: $shared_s0(tied-def 3)
# CHECK-LABEL: name: shared_copy_escape
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: literal_source
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: partial_domain
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: hidden_later_source
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: constant_mask
# CHECK: .elseif
# CHECK-SAME: killed $shared_s0,
# CHECK-LABEL: name: constant_partial_mask
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: nested_else
# CHECK: killed $shared_s0,
# CHECK-LABEL: name: unresolved_condition
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: malformed_condition
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: exclusive_arms
# CHECK: killed $shared_s0
# CHECK-LABEL: name: octal_condition
# CHECK: $shared_s0_ru

# CHECK-LABEL: name: redefined_slot
# CHECK: killed $shared_s0
# CHECK: killed $shared_s0
# CHECK-LABEL: name: partial_definition
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: literal_s37
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: partial_then_full
# CHECK: $shared_s0_ru
# CHECK: killed $shared_s0
# CHECK-LABEL: name: preexisting_retain
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: duplicate_inputs
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: generated_partial_definition
# CHECK: $shared_s0_ru
# CHECK-LABEL: name: mixed_generated
# CHECK: $shared_s0_ru
# CHECK: killed $shared_s0

--- |
  define void @local_repeated() { ret void }
  define void @local_duplicate() { ret void }
  define void @loop_liveout() { ret void }
  define void @branch_liveout() { ret void }
  define void @tied_definition() { ret void }
  define void @shared_copy_escape() { ret void }
  define void @literal_source() { ret void }
  define void @partial_domain() "linx-tile-pe-domain"="1" { ret void }
  define void @hidden_later_source() { ret void }
  define void @constant_mask() { ret void }
  define void @constant_partial_mask() { ret void }
  define void @nested_else() { ret void }
  define void @unresolved_condition() { ret void }
  define void @malformed_condition() { ret void }
  define void @exclusive_arms() { ret void }
  define void @octal_condition() { ret void }
  define void @redefined_slot() { ret void }
  define void @partial_definition() { ret void }
  define void @literal_s37() { ret void }
  define void @partial_then_full() { ret void }
  define void @preexisting_retain() { ret void }
  define void @duplicate_inputs() { ret void }
  define void @generated_partial_definition() { ret void }
  define void @mixed_generated() { ret void }
...
---
name: local_repeated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $tile_t1
    INLINEASM &"BSTART.TEPL 27, FP32\0AB.IOT $0, mask=1111, last\0ABSTART.TEPL 27, FP32\0AB.IOT $0, mask=1111, last", 1, 720905, $tile_t1
    PseudoRET
...
---
name: local_duplicate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $tile_t1
    INLINEASM &"B.IOT $0, $1, mask=1111, last", 1, 720905, $tile_t1, 720905, $tile_t1
    PseudoRET
...
---
name: loop_liveout
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $shared_s0
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $shared_s0, $r2
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    BEQ $r2, $r0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: branch_liveout
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $shared_s0, $r2
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
  bb.2:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: tied_definition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:R}, mask=1111", 1, 720906, def $shared_s0, 2147483657, $shared_s0(tied-def 3)
    PseudoRET
...
---
name: shared_copy_escape
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    $r10 = COPY $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    INLINEASM &"", 1, 9, $r10
    PseudoRET
...
---
name: literal_source
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111\0AB.IOS S0, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: partial_domain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: hidden_later_source
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    INLINEASM &"B.IOS S0, mask=1111", 1
    PseudoRET
...
---
name: constant_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if ${1:c} == 1\0AB.IOS ${0:S}, mask=0001\0A.elseif ${1:c} == 15\0AB.IOS ${0:S}, mask=1111\0A.else\0AB.IOS ${0:S}, mask=0010\0A.endif", 1, 720905, $shared_s0, 13, 15
    PseudoRET
...
---
name: constant_partial_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if ${1:c} == 1\0AB.IOS ${0:S}, mask=0001\0A.elseif ${1:c} == 15\0AB.IOS ${0:S}, mask=1111\0A.endif", 1, 720905, $shared_s0, 13, 1
    PseudoRET
...
---
name: nested_else
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if 1 == 2\0AB.IOS ${0:S}, mask=0001\0A.else\0A.if ${1:c} == 0\0AB.IOS ${0:S}, mask=0010\0A.else\0AB.IOS ${0:S}, mask=1111\0A.endif\0A.endif", 1, 720905, $shared_s0, 13, 15
    PseudoRET
...
---
name: unresolved_condition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0, $r2
    INLINEASM &".if ${1:c} == 15\0AB.IOS ${0:S}, mask=1111\0A.endif", 1, 720905, $shared_s0, 9, $r2
    PseudoRET
...
---
name: malformed_condition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if 1 == 1\0AB.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: exclusive_arms
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if 1 == 1\0AB.IOS ${0:S}, mask=1111\0A.else\0AB.IOS ${0:S}, mask=1111\0A.endif", 1, 720905, $shared_s0
    PseudoRET
...
---
name: octal_condition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &".if 010 == 10\0AB.IOS ${0:S}, mask=1111\0A.else\0AB.IOS ${0:S}, mask=0001\0A.endif", 1, 720905, $shared_s0
    PseudoRET
...
---
name: redefined_slot
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    INLINEASM &"B.IOS mask=1111, ->${0:S}<128B>", 1, 720906, def $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: partial_definition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    INLINEASM &"B.IOS mask=0001, ->${0:S}<128B>", 1, 720906, def $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: literal_s37
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    INLINEASM &"B.IOS S37, mask=1111", 1
    PseudoRET
...
---
name: partial_then_full
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=0001", 1, 720905, $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: preexisting_retain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0_ru
    PseudoRET
...
---
name: duplicate_inputs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    INLINEASM &"B.IOS ${0:S}, ${1:S}, mask=1111", 1, 720905, $shared_s0, 720905, $shared_s0
    PseudoRET
...
---
name: generated_partial_definition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0, $tile_t1
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    $shared_s0 = PseudoV5SharedL2S 1, 3, 1, 1, $tile_t1
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
---
name: mixed_generated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $shared_s0
    $tile_t = PseudoV5SharedS2L 1, 3, $shared_s0, 15, 1
    INLINEASM &"B.IOS ${0:S}, mask=1111", 1, 720905, $shared_s0
    PseudoRET
...
