# RUN: llc -mtriple=linx64v5-unknown-linux-musl -start-after=linxv5-emit-header -filetype=obj -o %t %s
# RUN: llvm-objdump -d --no-show-raw-insn -M no-tile-macros %t | FileCheck %s
#
# Issue #104: the PseudoEmptyTile placeholder (inserted by SlotCalc::BuildCopy
# for output-stack hand sync) must expand through the CodeGen emitter to a
# legal TLOAD transport with the correct MC operand order:
#   BSTART_TMA  = (DataType, TileOP)  ->  TLOAD, U8
#   C_B_DIMI    = (DstLoopReg, imm8)  ->  lb0, 1
# Issue #102's fix had both pairs reversed, encoding
#   BSTART.TLSU 27, FP64 / C.B.DIMI 0, ->lb1.
--- |
  define dso_local void @empty_tile() #0 {
    ret void
  }
  attributes #0 = { nounwind }
...
---
name:            empty_tile
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    $tile_t1 = PseudoEmptyTile 1
    ; CHECK-LABEL: <empty_tile>:
    ; The 10-byte bundle ends at the terminating `last` B.IOT (no BSTOP),
    ; byte-identical to the control ELF of issue #104:
    ;   81 11 01 d8 7c 00 13 ee 08 00
    ; CHECK: BSTART.TLSU TLOAD, U8
    ; CHECK-NEXT: C.B.DIMI 1, ->lb0
    ; CHECK-NEXT: B.IOT mask=1111, last, ->t<128B>
