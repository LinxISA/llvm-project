# RUN: llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -run-pass=linxv5-treg-to-offset -o /dev/null %s
#
# A CLOSED generation may be dead on one side of a join before a later,
# independent generation reuses the same physical parent register.  The old
# epoch must not make that dead join a global conflict.
--- |
  define void @independent_parent_epochs(i1 %cond) {
  entry:
    br i1 %cond, label %left, label %right
  left:
    br label %join
  right:
    br label %join
  join:
    ret void
  }
...
---
name:            independent_parent_epochs
alignment:       2
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2
    INLINEASM &"BSTART.TEPL 102, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9 /* sideeffect mayload attdialect */, 720906 /* regdef:Tile_ABS */, def $tile_u1, 13 /* imm */, 1
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1

  bb.1.left:
    successors: %bb.3(0x80000000)
    liveins: $tile_u1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9 /* sideeffect mayload attdialect */, 720906 /* regdef:Tile_ABS */, def $tile_t1, 720905 /* reguse:Tile_ABS */, $tile_u1, 13 /* imm */, 2, 13 /* imm */, 1, 13 /* imm */, 0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9 /* sideeffect mayload attdialect */, 720905 /* reguse:Tile_ABS */, killed $tile_t1, 720905 /* reguse:Tile_ABS */, $tile_u1, 13 /* imm */, 0, 13 /* imm */, 1
    PseudoBR %bb.3

  bb.2.right:
    successors: %bb.3(0x80000000)
    liveins: $tile_u1
    INLINEASM &"BSTART.TEPL 102, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT mask=1111, last, ->$0<${1:Z}>\0A", 9 /* sideeffect mayload attdialect */, 720906 /* regdef:Tile_ABS */, def dead $tile_t1, 13 /* imm */, 1
    PseudoBR %bb.3

  bb.3.join:
    liveins: $tile_u1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9 /* sideeffect mayload attdialect */, 720906 /* regdef:Tile_ABS */, def $tile_t1, 720905 /* reguse:Tile_ABS */, $tile_u1, 13 /* imm */, 2, 13 /* imm */, 1, 13 /* imm */, 0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9 /* sideeffect mayload attdialect */, 720905 /* reguse:Tile_ABS */, killed $tile_t1, 720905 /* reguse:Tile_ABS */, $tile_u1, 13 /* imm */, 0, 13 /* imm */, 1
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
