# RUN: llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -run-pass=linxv5-treg-to-offset -o - %s | FileCheck %s
#
# The two predecessor values join as the finite set {0, 1}.  Separate SETC
# producers and PseudoBRCondCARG consumers must filter that set on each edge.
# The final fallthrough is infeasible; reaching it would replace the OPEN
# parent with an ordinary definition before its continuation.
#
# CHECK-LABEL: name: assemble_parent_carg_finite_set
# CHECK-COUNT-4: B.ASSEMBLE
--- |
  define void @assemble_parent_carg_finite_set() { ret void }
...
---
name:            assemble_parent_carg_finite_set
alignment:       2
tracksRegLiveness: true
liveins:
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r2
    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 5, 13, 1, 13, 0
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1

  bb.1:
    successors: %bb.3(0x80000000)
    liveins: $tile_t1, $tile_u1
    $r5 = ORI $r0, 0
    PseudoBR %bb.3

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $tile_t1, $tile_u1
    $r5 = ORI $r0, 1
    PseudoBR %bb.3

  bb.3:
    successors: %bb.4(0x40000000), %bb.5(0x40000000)
    liveins: $r5, $tile_t1, $tile_u1
    SETC_LTI $r5, 1, implicit-def $carg
    PseudoBRCondCARG %bb.4, implicit $carg
    PseudoBR %bb.5

  bb.4:
    successors: %bb.7(0x80000000)
    liveins: $tile_t1, $tile_u1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, $tile_t1, 720905, $tile_u1, 13, 0, 13, 1
    PseudoBR %bb.7

  bb.5:
    successors: %bb.6(0x40000000), %bb.8(0x40000000)
    liveins: $r5, $tile_t1, $tile_u1
    SETC_LTUI $r5, 2, implicit-def $carg
    PseudoBRCondCARG %bb.6, implicit $carg
    PseudoBR %bb.8

  bb.6:
    successors: %bb.7(0x80000000)
    liveins: $tile_t1, $tile_u1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 1, 1\0A", 9, 720905, $tile_t1, 720905, $tile_u1, 13, 0, 13, 1
    PseudoBR %bb.7

  bb.8:
    successors: %bb.7(0x80000000)
    liveins: $tile_t1, $tile_u1
    $tile_t1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR CUBE_M32, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 0, 1\0A", 9, 720905, $tile_t1, 720905, $tile_u1, 13, 0, 13, 0
    PseudoBR %bb.7

  bb.7:
    liveins: $tile_t1, $tile_u1
    PseudoRET
...
