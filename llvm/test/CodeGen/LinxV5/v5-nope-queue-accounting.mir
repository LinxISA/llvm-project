    $tile_u1 = PseudoTCI_EW_SizeI $r0, 32, $r0, 1, 25, 29, 1, $r0, $r0
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR 25, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0AB.ASSEMBLE ${3:c}, ${4:c}, zero, 0, 1\0A", 9 /* sideeffect mayload attdialect */, 720906 /* regdef:Tile_ABS */, def $tile_t1, 720905 /* reguse:Tile_ABS */, killed $tile_u1, 13 /* imm */, 5, 13 /* imm */, 1, 13 /* imm */, 0
    dead $tile_t2 = PseudoTCOPY 1, $tile_t1
    PseudoRET
...
