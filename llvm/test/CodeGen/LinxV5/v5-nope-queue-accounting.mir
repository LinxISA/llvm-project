    dead $tile_t14 = PseudoEmptyTile 1
    dead $tile_t15 = PseudoEmptyTile 1
    dead $tile_t16 = PseudoEmptyTile 1
    dead $tile_t2 = PseudoEmptyTile 1
    INLINEASM &"BSTART.TEPL 27, 17\0AB.DATR 25, RNONE\0AB.DIM zero, 1, ->lb0\0AB.DIM zero, 32, ->lb1\0AB.IOT $1, mask=1111, last\0AB.IOT $0, mask=1111\0AB.ASSEMBLE ${2:c}, ${3:c}, zero, 15, 1\0A", 1 /* sideeffect attdialect */, 720905 /* reguse:Tile_ABS */, $tile_t1, 720905 /* reguse:Tile_ABS */, $tile_u1, 13 /* imm */, 0, 13 /* imm */, 1
    PseudoRET

    ; OPEN-NOPE: def $tile_t
    ; OPEN-NOPE-COUNT-16: PseudoEmptyTile 1
    ; OPEN-NOPE: B.ASSEMBLE {{.*}}$tile_tos1
...
