# RUN: llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -start-after=linxv5-emit-header -filetype=obj -o %t %s
# RUN: llvm-objdump -d --no-show-raw-insn %t | FileCheck %s
#
# A compiler-generated copy of a runtime-shaped CUBE tile must remain TLSU
# TMOV and carry all three live B.DIM registers. Omitted descriptors would
# default to NORM 1x1; generic CUBE pseudo expansion would select TMATMUL.
# CHECK: BSTART.TLSU TMOV, FP32
# CHECK-NEXT: B.DATR CUBE_M32.normal, Zero
# CHECK-NEXT: B.DIM s6, 4, ->lb0
# CHECK-NEXT: B.DIM s7, 5, ->lb1
# CHECK-NEXT: B.DIM s8, 6, ->lb2
# CHECK-NEXT: B.IOT t#1.reuse, mask=1111, last, ->u<32KB>
--- |
  define void @runtime_descriptor_copy() { ret void }
...
---
name: runtime_descriptor_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r17, $r18, $r19, $tile_t1
    $tile_t2 = PseudoTMOV_SizeI $r17, 4, $r18, 5, $r19, 6, 1, 9, $tile_t1, 29, 0, 31
...
