# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -linxv5-enable-generic-element=true -run-pass=postrapseudos \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -linxv5-enable-generic-element=false -run-pass=postrapseudos \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s
#
# The FP16 source row fits 128 bytes; the 1 x 64 U32 index result does not.
# CHECK: LLVM ERROR: Local tile descriptor geometry does not fit its SizeCode: rows=1, cols=64, physicalCols=64, dtype=25, layout=0, size=1
--- |
  define void @col_arg_capacity() { ret void }
...
---
name: col_arg_capacity
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR NORM, Null\0AB.DIM zero, 64, ->lb0\0AB.DIM zero, 1, ->lb1\0AB.DIM zero, 64, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
