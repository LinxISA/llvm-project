# RUN: split-file %s %t
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=true -o /dev/null %t/m16.mir 2>&1 | FileCheck %s --check-prefix=M16
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=false -o /dev/null %t/m16.mir 2>&1 | FileCheck %s --check-prefix=M16
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=true -o /dev/null %t/m32.mir 2>&1 | FileCheck %s --check-prefix=M32
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=false -o /dev/null %t/m32.mir 2>&1 | FileCheck %s --check-prefix=M32
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=false -o /dev/null %t/legacy-m16.mir 2>&1 | FileCheck %s --check-prefix=M16
# RUN: not llc -mtriple=linx64v5-unknown-linux-musl -run-pass=postrapseudos \
# RUN:   -linxv5-enable-generic-element=false -o /dev/null %t/legacy-m32.mir 2>&1 | FileCheck %s --check-prefix=M32
#
# A column ARG writer must publish the rounded U32 width, even if a larger
# allocation could hold all valid elements. Do not normalize away a mismatch.
# M16: column ARG result shape does not match CUBE capacity: cols=5, capacityCols=8, size=3
# M32: column ARG result shape does not match CUBE capacity: cols=3, capacityCols=4, size=3

#--- m16.mir
--- |
  define void @capacity() { ret void }
...
---
name: capacity
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M16, Null\0AB.DIM zero, 5, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...

#--- m32.mir
--- |
  define void @capacity() { ret void }
...
---
name: capacity
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M32, Null\0AB.DIM zero, 3, ->lb0\0AB.DIM zero, 16, ->lb1\0AB.DIM zero, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3
    $tile_t2 = COPY $tile_t1
    PseudoRET
...

#--- legacy-m16.mir
--- |
  define void @capacity() { ret void }
...
---
name: capacity
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M16, Null\0AB.DIM $3, 5, ->lb0\0AB.DIM $3, 16, ->lb1\0AB.DIM $3, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3, 2293769, $r0
    $tile_t2 = COPY $tile_t1
    PseudoRET
...

#--- legacy-m32.mir
--- |
  define void @capacity() { ret void }
...
---
name: capacity
tracksRegLiveness: true
body: |
  bb.0:
    $tile_u1 = IMPLICIT_DEF
    INLINEASM &"BSTART.TEPL 92, FP16\0AB.DATR CUBE_M32, Null\0AB.DIM $3, 3, ->lb0\0AB.DIM $3, 16, ->lb1\0AB.DIM $3, 8, ->lb2\0AB.IOT $1, mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_t1, 720905, $tile_u1, 13, 3, 2293769, $r0
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
