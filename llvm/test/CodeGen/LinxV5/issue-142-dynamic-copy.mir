# RUN: llc -mtriple=linx64v5 -run-pass=postrapseudos -o - %s | FileCheck %s
# CHECK-LABEL: name: dynamic_cube_copy
# CHECK: $tile_t2 = PseudoTCOPYDesc 9, $tile_t1, $r2, $r3, 256, 1, 29
# CHECK-LABEL: name: dynamic_norm_copy
# CHECK: $tile_u2 = PseudoTCOPYDesc 3, $tile_u1, $r2, 1, $r2, 25, 0
--- |
  define void @dynamic_cube_copy() { ret void }
  define void @dynamic_norm_copy() { ret void }
...
---
name: dynamic_cube_copy
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r2, $r3
    $r4 = ORI $r2, 0
    $r5 = ORI $r3, 0
    INLINEASM &"BSTART.TEPL 0, FP32\0AB.DATR CUBE_M32, Null\0AB.DIM $1, 0, ->lb0\0AB.DIM $2, 0, ->lb1\0AB.DIM zero, 256, ->lb2\0AB.IOT mask=1111, last, ->$0<${3:Z}>\0A", 9, 720906, def $tile_t1, 2621449, $r4, 2621449, $r5, 13, 9
    PseudoBR %bb.1
  bb.1:
    liveins: $r2, $r3, $tile_t1
    $tile_t2 = COPY $tile_t1
    PseudoRET
...
---
name: dynamic_norm_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2
    INLINEASM &"BSTART.TEPL 0, U32\0AB.DATR NORM, Null\0AB.DIM $1, 0, ->lb0\0AB.IOT mask=1111, last, ->$0<${2:Z}>\0A", 9, 720906, def $tile_u1, 2621449, $r2, 13, 3
    $tile_u2 = COPY $tile_u1
    PseudoRET
...
