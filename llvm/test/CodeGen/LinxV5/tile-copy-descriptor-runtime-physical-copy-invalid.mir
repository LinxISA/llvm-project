# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -run-pass=postrapseudos -o /dev/null %s 2>&1 | FileCheck %s
# CHECK: cannot lower a physical COPY with runtime Tile descriptor registers before reaching-definition proof
#
# Post-RA physical COPY expansion cannot establish that the B.DIM registers
# still contain the values captured by the runtime-shaped Tile producer.  It
# must fail closed instead of manufacturing a PseudoTMOV with raw physical
# register dependencies.
--- |
  define void @runtime_descriptor_physical_copy() { ret void }
...
---
name: runtime_descriptor_physical_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r17, $r18, $r19, $tile_t1
    INLINEASM &"BSTART.TEPL 0, FP32\0AB.DATR CUBE_M32, Null\0AB.DIM $1, 4, ->lb0\0AB.DIM $2, ${4:c}, ->lb1\0AB.DIM $3, 6, ->lb2\0AB.IOT $6.reuse, mask=1111, last, ->$0<${5:Z}>\0A", 9, 720906, def $tile_t2, 2293769, $r17, 2293769, $r18, 2293769, $r19, 13, 5, 13, 9, 720905, $tile_t1
    $r17 = ORI $r0, 7
    $tile_t3 = COPY $tile_t2
...
