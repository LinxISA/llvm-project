# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -linxv5-enable-generic-element=true -run-pass=postrapseudos \
# RUN:   -o /dev/null %t/dynamic-gather.mir 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -linxv5-enable-generic-element=true -run-pass=postrapseudos \
# RUN:   -o /dev/null %t/float-tlea.mir 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=linx64v5-unknown-linux-musl \
# RUN:   -linxv5-enable-generic-element=true -run-pass=postrapseudos \
# RUN:   -o /dev/null %t/dynamic-row-gather.mir 2>&1 | FileCheck %s
# CHECK: cannot prove a complete Local tile descriptor for COPY/PHI
#
# Runtime dimensions cannot be guessed; a malformed floating TLEA cannot
# acquire a fabricated integer result descriptor merely to satisfy COPY.
#--- dynamic-gather.mir
--- |
  define void @dynamic_gather_copy() { ret void }
...
---
name: dynamic_gather_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2, $r3, $r4, $tile_t3
    $tile_t1 = PseudoMGATHER_GPR_Masked_SizeI $r4, 1, $r0, 32, 25, 0, 29, 1, $tile_t3, $r2, $r0, $r3, 0, 1
    $tile_t2 = COPY $tile_t1
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
#--- float-tlea.mir
--- |
  define void @float_tlea_copy() { ret void }
...
---
name: float_tlea_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $tile_t3
    $tile_t1 = PseudoTLEA_SizeI $r0, 32, $r0, 1, 1, 29, 2, $tile_t3, $r4
    $tile_t2 = COPY $tile_t1
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
#--- dynamic-row-gather.mir
--- |
  define void @dynamic_row_gather_copy() { ret void }
...
---
name: dynamic_row_gather_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2, $r3, $r4, $tile_t3
    $tile_t1 = PseudoMGATHER_GPR_Masked_SizeI $r0, 1, $r4, 32, 25, 0, 29, 1, $tile_t3, $r2, $r0, $r3, 0, 1
    $tile_t2 = COPY $tile_t1
    C_SETC_TGT $r10, implicit-def $carg
    PseudoRETCARG implicit $carg
...
