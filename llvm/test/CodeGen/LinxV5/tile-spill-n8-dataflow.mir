# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-tile-fixup %s -o - | FileCheck %s
# RUN: llc -mtriple=linx64v5 -start-before=linxv5-tile-fixup %s -o %t.s
# RUN: llc -mtriple=linx64v5 -start-before=linxv5-tile-fixup -filetype=obj %s -o %t.o
# RUN: llvm-mc -triple=linx64v5 -filetype=obj %t.s -o %t.roundtrip.o
# Valid [5,17] FP32 rounds to [8,24], using 768 of 1024 allocated bytes.
# Neither the unaligned valid width nor the physical width divides capacity.
# CHECK: PseudoTSpillDesc killed $tile_u1, %stack.0, 17, 5, 24, 1, 23, 4
# CHECK: $tile_n1 = PseudoTReloadDesc %stack.0, 17, 5, 24, 1, 23, 4
--- |
  define void @n8_dataflow() { ret void }
...
---
name: n8_dataflow
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 1024, alignment: 256, stack-id: default }
body: |
  bb.0:
    liveins: $r20
    $tile_u1 = PseudoTLOAD_noDsrc_noDdst $r0, 17, $r0, 5, $r0, 1, 1, 4, 23, 0, $r20
    PseudoTSpill killed $tile_u1, %stack.0 :: (store (s8192) into %stack.0, align 256)
    $tile_n1 = PseudoTReload %stack.0 :: (load (s8192) from %stack.0, align 256)
    PseudoTSTORE_noDsrc_noDdst killed $tile_n1, $r0, 17, $r0, 5, $r0, 1, 1, 26, $r20
    PseudoRET
...
