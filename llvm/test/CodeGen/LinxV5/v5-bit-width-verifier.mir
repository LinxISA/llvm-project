# RUN: llc -mtriple=linx64v5 -run-pass=machineverifier %s -o /dev/null
# RUN: sed 's/32, 32/32, 0/' %s > %t.zero.mir
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=machineverifier %t.zero.mir -o /dev/null 2>&1 | FileCheck %s
# RUN: sed 's/0, 64/0, 65/' %s > %t.large.mir
# RUN: not --crash llc -mtriple=linx64v5 -run-pass=machineverifier %t.large.mir -o /dev/null 2>&1 | FileCheck %s

# CHECK: Bad machine code: Invalid immediate

---
name: bit_width_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    $r5 = BIC $r1, 32, 32
    $r6 = BIC $r1, 0, 64
    PseudoRET
...
