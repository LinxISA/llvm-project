# RUN: %python -c 'import pathlib,sys; s=pathlib.Path(sys.argv[1]).read_text(); pathlib.Path(sys.argv[2]).write_text(s.replace("    %1:tile_abs", "    $r5 = ORI $r0, 0\n" * 16384 + "    %1:tile_abs", 1))' %S/v5-assemble-parent-phase-offset-cycle.mir %t.mir
