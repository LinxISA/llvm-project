# RUN: llc -mtriple=linx64v5 -run-pass=linxv5-tile-definedness %s -o - | FileCheck %s
--- |
  define void @typed_phi() { ret void }
  define void @unknown_seed() { ret void }
  define void @conflicting_phi() { ret void }
...
---
name: typed_phi
tracksRegLiveness: true
registers:
  - { id: 0, class: tile_abs_cg }
  - { id: 1, class: tile_abs_cg }
  - { id: 2, class: tile_abs_cg }
  - { id: 3, class: tile_abs }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2
    %0:tile_abs_cg = IMPLICIT_DEF
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.2
    %3:tile_abs = PseudoTCI_EW_Row_SizeI $r0, 32, $r0, 1, 1, 29, 1, $r0, $r0, 1
    %1:tile_abs_cg = COPY %3
    PseudoBR %bb.2
  bb.2:
    %2:tile_abs_cg = PHI %0, %bb.0, %1, %bb.1
    INLINEASM &"", 1, 786441, %2
    PseudoRET
# CHECK-LABEL: name: typed_phi
# CHECK: %{{[0-9]+}}:tile_abs = PseudoTCI_EW_Row_SizeI $r0, 32, $r0, 1, 1, 29, 1, $r0, $r0, 1
# CHECK: %0:tile_abs_cg = COPY
# CHECK: %2:tile_abs_cg = PHI
...
---
name: unknown_seed
tracksRegLiveness: true
registers:
  - { id: 0, class: tile_abs_cg }
body: |
  bb.0:
    %0:tile_abs_cg = IMPLICIT_DEF
    INLINEASM &"", 1, 786441, %0
    PseudoRET
# CHECK-LABEL: name: unknown_seed
# CHECK: %0:tile_abs_cg = IMPLICIT_DEF
...
---
name: conflicting_phi
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2
    %0:tile_abs = IMPLICIT_DEF
    BEQ $r2, $r0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.2
    %1:tile_abs = PseudoTCI_EW_Row_SizeI $r0, 32, $r0, 1, 1, 29, 1, $r0, $r0, 1
    %2:tile_abs = PseudoTCI_EW_Row_SizeI $r0, 32, $r0, 1, 17, 29, 1, $r0, $r0, 1
    PseudoBR %bb.2
  bb.2:
    %3:tile_abs = PHI %0, %bb.0, %1, %bb.1
    %4:tile_abs = PHI %0, %bb.0, %2, %bb.1
    INLINEASM &"", 1, 786441, %3, 786441, %4
    PseudoRET
# CHECK-LABEL: name: conflicting_phi
# CHECK: %0:tile_abs = IMPLICIT_DEF
