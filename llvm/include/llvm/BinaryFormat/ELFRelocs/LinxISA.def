ELF_RELOC(R_LINX_B17_PCREL, 4)
ELF_RELOC(R_LINX_HL_BSTART30_PCREL, 5)
ELF_RELOC(R_LINX_B25_PCREL, 22)
ELF_RELOC(R_LINX_CSETRET5_PCREL, 6)
ELF_RELOC(R_LINX_SETRET20_PCREL, 7)
ELF_RELOC(R_LINX_HL_SETRET32_PCREL, 8)
ELF_RELOC(R_LINX_PCREL_HI20, 15)
ELF_RELOC(R_LINX_B17_PLT, 16)
ELF_RELOC(R_LINX_LO12, 17)
ELF_RELOC(R_LINX_PCR17_LOAD, 18)
ELF_RELOC(R_LINX_PCR17_STORE, 19)
ELF_RELOC(R_LINX_HL_PCR29_LOAD, 20)
ELF_RELOC(R_LINX_HL_PCR29_STORE, 21)
