ELF_RELOC(R_LINX_TLS_DTPMOD64, 28)
ELF_RELOC(R_LINX_TLS_DTPREL64, 29)
ELF_RELOC(R_LINX_TLS_TPREL64, 30)
ELF_RELOC(R_LINX_TLSDESC, 31)
